# Real wall-clock audiovisual host.
#
# stdin: newline-delimited model actions from syllogimous_actions.elisa
# stdout: repeated binary SensoryEnvelope records containing only timestamp,
#         RGB pixels, and PCM. No evaluator or game-state value is serialized.

include "syllogimous_runtime.elisa"
include "syllogimous_host_config.elisa"

extern clock_gettime(clock_id: int, value: void&) -> int
extern poll(items: void&, count: u32, timeout_ms: int) -> int
extern read(fd: int, destination: void&, count: usize) -> isize
extern write(fd: int, source: u8&, count: usize) -> isize
extern usleep(usec: u32) -> int

struct HostTimespec layout(c):
    seconds: mutable i64
    nanoseconds: mutable i64

struct HostPollFd layout(c):
    fd: mutable i32
    events: mutable i16
    returned: mutable i16

global HOST_WIDTH: i32 = 640
global HOST_HEIGHT: i32 = 400
global HOST_RGB_BYTES: i32 = 768000
global HOST_HEADER_BYTES: i32 = 36
global HOST_SAMPLE_RATE: i32 = 16000
global mutable HOST_RGB: array[u8, 768000] = zeroed
global mutable HOST_HEADER: array[u8, 36] = zeroed
global mutable HOST_INPUT: array[u8, 256] = zeroed
global mutable HOST_LINE: array[u8, 256] = zeroed
global mutable HOST_LINE_LENGTH: i32 = 0

struct HostInput:
    keep_running: bool
    has_line: bool

def host_now_ms() -> i64 where result >= 0:
    stamp: mutable HostTimespec = zeroed
    trusted Unsafe.PointerCast:
        _ = clock_gettime(6, (&stamp).cast[void&])
    raw: i64 = stamp.seconds * 1000 + stamp.nanoseconds / 1000000
    assert raw >= 0
    return raw

def header_u32(offset: i32 where offset >= 0 and offset <= 32,
               value: u32) -> void:
    for byte in 0..<4:
        HOST_HEADER[(offset + byte).usize()] <- (
            (value >> (byte * 8).u8()) & 255
        ).u8()

def header_i64(offset: i32 where offset >= 0 and offset <= 28,
               value: i64 where value >= 0) -> void:
    unsigned: u64 = value.u64()
    for byte in 0..<8:
        HOST_HEADER[(offset + byte).usize()] <- (
            (unsigned >> (byte * 8).u8()) & 255
        ).u8()

def prepare_header(packet: SensoryPacket&) -> void:
    # "SYLLAV1\n" followed by little-endian scalar fields.
    HOST_HEADER[0] <- 83
    HOST_HEADER[1] <- 89
    HOST_HEADER[2] <- 76
    HOST_HEADER[3] <- 76
    HOST_HEADER[4] <- 65
    HOST_HEADER[5] <- 86
    HOST_HEADER[6] <- 49
    HOST_HEADER[7] <- 10
    assert packet.timestamp_ms >= 0
    header_i64(8, packet.timestamp_ms)
    header_u32(16, packet.width.u32())
    header_u32(20, packet.height.u32())
    header_u32(24, HOST_RGB_BYTES.u32())
    header_u32(28, packet.pcm_count.u32())
    header_u32(32, HOST_SAMPLE_RATE.u32())

def pack_rgb() -> void:
    for pixel in 0..<(HOST_WIDTH * HOST_HEIGHT):
        value: u32 = Encoder::SCREEN_GRAB[pixel.usize()]
        base: i32 = pixel * 3
        HOST_RGB[base.usize()] <- ((value >> 16) & 255).u8()
        HOST_RGB[(base + 1).usize()] <- ((value >> 8) & 255).u8()
        HOST_RGB[(base + 2).usize()] <- (value & 255).u8()

def write_all(source: u8&, count: i32 where count >= 0) -> bool:
    offset: mutable i32 = 0
    while offset < count:
        remaining: i32 = count - offset
        assert remaining > 0
        written: isize = write(1, &source[offset.usize()], remaining.usize())
        if written <= 0:
            return false
        offset <- offset + written.i32()
    return true

def emit_sensory(packet: SensoryPacket&) -> bool:
    prepare_header(packet)
    pack_rgb()
    if not write_all(&HOST_HEADER[0], HOST_HEADER_BYTES):
        return false
    if not write_all(&HOST_RGB[0], HOST_RGB_BYTES):
        return false
    pcm_bytes: i32 = packet.pcm_count * 2
    assert pcm_bytes >= 0 and pcm_bytes <= 40960
    trusted Unsafe.PointerCast:
        return write_all((&packet.pcm[0]).cast[u8&], pcm_bytes)

def submit_host_line(runtime: GameRuntime,
                     now_ms: i64 where now_ms >= 0) -> GameRuntime:
    next: mutable GameRuntime = runtime
    if HOST_LINE_LENGTH == 0:
        return next
    HOST_LINE[HOST_LINE_LENGTH.usize()] <- 0
    rebind result: DriverScene error[ActionParseError, EpisodeError, LedgerError, DriverError, RuntimeError], next = apply_runtime_text(
        next, &HOST_LINE[0], now_ms
    )
    accepted: bool = catch result:
        scene: true
        error failure: false
    HOST_LINE_LENGTH <- 0
    return next

def tick_host(runtime: GameRuntime,
              now_ms: i64 where now_ms >= 0) -> GameRuntime:
    next: mutable GameRuntime = runtime
    rebind result: DriverScene error[GenerationError, EpisodeError, LedgerError, DriverError, RuntimeError], next = tick_game_runtime(
        next, now_ms
    )
    ignored: bool = catch result:
        scene: true
        error failure: false
    return next

def consume_input() -> HostInput:
    descriptor: mutable HostPollFd = HostPollFd{fd: 0, events: 1, returned: 0}
    available: mutable int = 0
    trusted Unsafe.PointerCast:
        available <- poll((&descriptor).cast[void&], 1, 0)
    if available <= 0:
        return HostInput{keep_running: true, has_line: false}
    received: mutable isize = 0
    trusted Unsafe.PointerCast:
        received <- read(0, (&HOST_INPUT[0]).cast[void&], 255.usize())
    if received == 0:
        return HostInput{keep_running: false, has_line: false}
    if received < 0:
        return HostInput{keep_running: true, has_line: false}
    count: i32 = received.i32()
    line_emitted: mutable bool = false
    for index in 0..<count:
        byte: u8 = HOST_INPUT[index.usize()]
        if byte == 10 or byte == 13:
            if HOST_LINE_LENGTH > 0 and not line_emitted:
                line_emitted <- true
        elif not line_emitted and HOST_LINE_LENGTH < 255:
            HOST_LINE[HOST_LINE_LENGTH.usize()] <- byte
            HOST_LINE_LENGTH <- HOST_LINE_LENGTH + 1
    return HostInput{keep_running: true, has_line: line_emitted}

def run_host(seed: i32,
             started_ms: i64 where started_ms >= 0,
             fps: i32 where fps >= 1 and fps <= 120) -> int error[DriverError, GenerationError]:
    runtime: mutable GameRuntime = try start_game_runtime(seed, hard_host_selection(), started_ms)
    frame: mutable i64 = 0
    running: mutable bool = true
    while running:
        now_ms: i64 where now_ms >= 0 = host_now_ms()
        input: HostInput = consume_input()
        running <- input.keep_running
        if input.has_line:
            runtime <- submit_host_line(runtime, now_ms)
        if frame > 0:
            runtime <- tick_host(runtime, now_ms)
        packet: SensoryPacket = try observe_game_runtime(runtime, now_ms)
        if not emit_sensory(packet):
            return 4
        frame <- frame + 1
        target_ms: i64 = started_ms + frame * 1000 / fps
        after_write: i64 = host_now_ms()
        if target_ms > after_write:
            delay_us: i64 = (target_ms - after_write) * 1000
            if delay_us > 0 and delay_us <= 4294967295:
                _ = usleep(delay_us.u32())
    return 0

def main() -> int:
    started_ms: i64 where started_ms >= 0 = host_now_ms()
    return catch run_host(7, started_ms, 30):
        code: code
        GenerationError.NoEnabledFamily: 20
        GenerationError.TooFewPremises: 21
        GenerationError.NoEnabledBinaryOperator: 22
        GenerationError.AnalogyNeedsBaseFamily: 23
        GenerationError.BinaryNeedsTwoBaseFamilies: 24
        GenerationError.RetryBudgetExhausted: 25
        GenerationError.InvalidConfiguration: 26
        GenerationError.UnsupportedRelation: 27
        GenerationError.DisconnectedQuestion: 28
        DriverError.CardUnavailable: 29
        DriverError.InvalidFeedback: 29
        DriverError.MissingSubmission: 29
