# Cross-round real-time game lifecycle.

include "syllogimous_scene.elisa"

global FEEDBACK_DURATION_MS: i64 = 1200

enum RuntimeState:
    Playing(driver: RealtimeDriver)
    Feedback(driver: RealtimeDriver, until_ms: i64)

error RuntimeError:
    FeedbackActive
    InvalidFeedbackDeadline

struct GameRuntime:
    rng: mutable Rng
    presentation_state: mutable PresentationState
    selection: SelectionConfig
    ledger: mutable GameLedger
    state: mutable RuntimeState

def prepare_next_driver_once(rng: lmut Rng,
                             presentation_state: lmut PresentationState,
                             selection: SelectionConfig&,
                             started_ms: i64 where started_ms >= 0) -> RealtimeDriver error[GenerationError]:
    rebind plan_result: SelectedQuestionPlan error[GenerationError], rng = select_question_plan(
        rng, selection
    )
    plan: SelectedQuestionPlan = try plan_result
    rebind session_result: PreparedSession error[GenerationError], rng, presentation_state = prepare_session(
        rng, presentation_state, plan, selection.game, started_ms
    )
    return initial_realtime_driver(try session_result)

# Individual upstream generators use retry loops around unsuitable random
# draws. Preserve that behavior at the session boundary without hiding an
# infinite loop: RNG advances after every failed attempt and the typed error is
# returned if 64 attempts cannot produce a complete public/private session.
def prepare_next_driver(rng: lmut Rng,
                        presentation_state: lmut PresentationState,
                        selection: SelectionConfig&,
                        started_ms: i64 where started_ms >= 0) -> RealtimeDriver error[GenerationError]:
    for attempt in 0..<64:
        rebind attempt_result: RealtimeDriver error[GenerationError], rng, presentation_state = prepare_next_driver_once(
            rng, presentation_state, selection, started_ms
        )
        failed: bool = catch attempt_result:
            driver:
                return driver
            error failure:
                # Error-union return paths do not commit `lmut` rebinds. Move
                # the caller-owned RNG explicitly so the next attempt is a new
                # draw rather than the same deterministic failure forever.
                rebind discarded: i32, rng = random_below(rng, 2147483647)
                true
    raise GenerationError.RetryBudgetExhausted

def start_game_runtime(seed: u64,
                       selection: SelectionConfig,
                       started_ms: i64 where started_ms >= 0) -> GameRuntime error[GenerationError]:
    rng: mutable Rng = rng_from_seed(seed)
    presentation_state: mutable PresentationState = initial_presentation_state()
    rebind driver_result: RealtimeDriver error[GenerationError], rng, presentation_state = prepare_next_driver(
        rng, presentation_state, selection, started_ms
    )
    return GameRuntime{
        rng: rng,
        presentation_state: presentation_state,
        selection: selection,
        ledger: initial_game_ledger(),
        state: RuntimeState.Playing(try driver_result)
    }

def scene_is_feedback(scene: DriverScene) -> bool:
    return match scene:
        DriverScene.Feedback(card): true
        _: false

def enter_runtime_scene(runtime: lmut GameRuntime,
                        driver: RealtimeDriver,
                        scene: DriverScene,
                        now_ms: i64 where now_ms >= 0) -> void:
    if scene_is_feedback(scene):
        assert now_ms <= 9223372036854774607
        until_ms: i64 = now_ms + FEEDBACK_DURATION_MS
        runtime.state <- RuntimeState.Feedback(driver, until_ms)
    else:
        runtime.state <- RuntimeState.Playing(driver)

def apply_runtime_text(runtime: lmut GameRuntime,
                       text: u8&,
                       now_ms: i64 where now_ms >= 0) -> DriverScene error[ActionParseError, EpisodeError, LedgerError, DriverError, RuntimeError]:
    match runtime.state:
        RuntimeState.Feedback(driver, until_ms):
            raise RuntimeError.FeedbackActive
        RuntimeState.Playing(current):
            driver: mutable RealtimeDriver = current
            ledger: mutable GameLedger = runtime.ledger
            rebind scene_result: DriverScene error[ActionParseError, EpisodeError, LedgerError, DriverError], driver, ledger = apply_driver_text(
                driver, ledger, text, now_ms
            )
            scene: DriverScene = try scene_result
            runtime.ledger <- ledger
            runtime <- enter_runtime_scene(runtime, driver, scene, now_ms)
            return scene
    raise RuntimeError.FeedbackActive

def tick_playing_runtime(runtime: lmut GameRuntime,
                         current: RealtimeDriver,
                         now_ms: i64 where now_ms >= 0) -> DriverScene error[EpisodeError, LedgerError, DriverError]:
    driver: mutable RealtimeDriver = current
    ledger: mutable GameLedger = runtime.ledger
    rebind scene_result: DriverScene error[EpisodeError, LedgerError, DriverError], driver, ledger = tick_driver(
        driver, ledger, now_ms
    )
    scene: DriverScene = try scene_result
    runtime.ledger <- ledger
    runtime <- enter_runtime_scene(runtime, driver, scene, now_ms)
    return scene

def begin_runtime_round(runtime: lmut GameRuntime,
                        now_ms: i64 where now_ms >= 0) -> DriverScene error[GenerationError, DriverError]:
    rng: mutable Rng = runtime.rng
    presentation_state: mutable PresentationState = runtime.presentation_state
    rebind driver_result: RealtimeDriver error[GenerationError], rng, presentation_state = prepare_next_driver(
        rng, presentation_state, runtime.selection, now_ms
    )
    driver: RealtimeDriver = try driver_result
    runtime.rng <- rng
    runtime.presentation_state <- presentation_state
    runtime.state <- RuntimeState.Playing(driver)
    return try current_driver_scene(driver)

def tick_game_runtime(runtime: lmut GameRuntime,
                      now_ms: i64 where now_ms >= 0) -> DriverScene error[GenerationError, EpisodeError, LedgerError, DriverError, RuntimeError]:
    match runtime.state:
        RuntimeState.Playing(driver):
            rebind result: DriverScene error[EpisodeError, LedgerError, DriverError], runtime = tick_playing_runtime(
                runtime, driver, now_ms
            )
            return try result
        RuntimeState.Feedback(driver, until_ms):
            raise RuntimeError.InvalidFeedbackDeadline if until_ms < 0
            if now_ms < until_ms:
                return try current_driver_scene(driver)
            rebind result: DriverScene error[GenerationError, DriverError], runtime = begin_runtime_round(
                runtime, now_ms
            )
            return try result
    raise RuntimeError.InvalidFeedbackDeadline

def observe_game_runtime(runtime: GameRuntime&,
                         now_ms: i64 where now_ms >= 0) -> SensoryPacket error[DriverError]:
    match runtime.state:
        RuntimeState.Playing(driver):
            return try observe_driver_sensory(driver, now_ms)
        RuntimeState.Feedback(driver, until_ms):
            return try observe_driver_sensory(driver, now_ms)
    raise DriverError.CardUnavailable
