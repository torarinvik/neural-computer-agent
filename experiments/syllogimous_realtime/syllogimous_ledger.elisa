# Cross-round score and compact response history.
#
# The upstream browser stores entire private question objects in localStorage.
# This evaluator keeps only public gameplay metadata: family, submitted action,
# outcome, millisecond latency, and reward. Private truth and sorting keys never
# enter the history exposed to sensory renderers.

include "syllogimous_game.elisa"

error LedgerError:
    EpisodeActive
    InvalidSubmission

def initial_game_ledger() -> GameLedger:
    return GameLedger{
        score: 0,
        rounds: 0,
        recent: zeroed,
        recent_count: 0
    }

def submission_matches_task(submitted: SubmittedAnswer,
                            task: EpisodeTask) -> bool:
    match task:
        EpisodeTask.TruthAnswer(expected):
            match submitted:
                SubmittedAnswer.TimedOut:
                    return true
                SubmittedAnswer.TruthValue(value):
                    return true
                SubmittedAnswer.SortingOrder:
                    return false
        EpisodeTask.SortingAnswer(expected_order, card_count):
            match submitted:
                SubmittedAnswer.TimedOut:
                    return true
                SubmittedAnswer.TruthValue(value):
                    return false
                SubmittedAnswer.SortingOrder:
                    return true
    return false

def record_finished_episode(ledger: lmut GameLedger,
                            family: QuestionFamily,
                            submitted: SubmittedAnswer,
                            episode: RealtimeEpisode) -> RoundRecord error[LedgerError]:
    raise LedgerError.InvalidSubmission if not submission_matches_task(
        submitted, episode.task
    )
    match episode.status:
        EpisodeStatus.Active:
            raise LedgerError.EpisodeActive
        EpisodeStatus.Finished(outcome, reward):
            assert episode.last_event_ms >= episode.started_ms
            assert reward.correctness_milli >= -1000 and reward.correctness_milli <= 1000
            assert reward.speed_milli >= 0 and reward.speed_milli <= 50
            elapsed: i64 where elapsed >= 0 = episode.last_event_ms - episode.started_ms
            record: RoundRecord = RoundRecord{
                family: family,
                submitted: submitted,
                outcome: outcome,
                elapsed_ms: elapsed,
                correctness_milli: reward.correctness_milli,
                speed_milli: reward.speed_milli
            }
            # Keep exact lifetime score/round totals while retaining the most
            # recent 1024 public records in a bounded ring. A long-running
            # trainer must not stop merely because diagnostic history filled.
            index_raw: i64 = ledger.rounds % 1024
            assert index_raw >= 0 and index_raw < 1024
            index: i32 = index_raw.i32()
            assert index >= 0 and index < 1024
            ledger.recent[index.usize()] <- record
            ledger.recent_count <- (
                ledger.recent_count + 1 if ledger.recent_count < 1024 else 1024
            )
            ledger.rounds <- ledger.rounds + 1
            ledger.score <- ledger.score + (
                1 if outcome == Outcome.Correct else -1
            )
            return record
    raise LedgerError.EpisodeActive

def latest_round(ledger: GameLedger&) -> RoundRecord error[LedgerError]:
    raise LedgerError.EpisodeActive if ledger.recent_count == 0
    index_raw: i64 = (ledger.rounds - 1) % 1024
    assert index_raw >= 0 and index_raw < 1024
    index: i32 = index_raw.i32()
    assert index >= 0 and index < 1024
    return ledger.recent[index.usize()]
