include "syllogimous_session.elisa"
include "syllogimous_host_config.elisa"

def check_challenge_selection() -> int error[GenerationError]:
    config: SelectionConfig = hard_host_selection()
    found: mutable bool = false
    for seed in 0..<512:
        rng: mutable Rng = rng_from_seed(seed.u64())
        rebind plan_result: SelectedQuestionPlan error[GenerationError], rng = select_question_plan(
            rng, config
        )
        plan: SelectedQuestionPlan = try plan_result
        match plan:
            SelectedQuestionPlan.Generated(family, deadline_ms):
                if family == QuestionFamily.LogicPuzzle:
                    rebind question_result: Question error[GenerationError], rng = execute_question_plan(
                        rng, plan, config.game
                    )
                    question: Question = try question_result
                    match question:
                        Question.Challenge(content):
                            if content.value_count < 1 or content.value_count > 16:
                                return 1
                            solution: ChallengeSolution = try unique_challenge_solution(content)
                            if solution.candidate_count != 1 or solution.answer != content.answer:
                                return 4
                            if not try verify_challenge(content, content.answer):
                                return 5
                            found <- true
                        _:
                            return 2
            _:
                pass
        if found:
            return 0
    return 3

def main() -> int:
    return catch check_challenge_selection():
        code: code
        error failure: 99
