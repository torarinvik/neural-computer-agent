# Default real-time host curriculum: all upstream families enabled.
include "syllogimous_types.elisa"
include "syllogimous_generators.elisa"

def host_family(enabled: bool,
                deadline_ms: i64 where deadline_ms >= 5000 and deadline_ms <= 300000) -> FamilyConfig:
    return FamilyConfig{enabled: enabled, deadline_ms: deadline_ms}

def hard_host_selection() -> SelectionConfig:
    deadline: i64 where deadline >= 5000 and deadline <= 300000 = 10000
    return SelectionConfig{
        game: GameConfig{
            difficulty: DifficultyTier.Max,
            premises: 16,
            vocabulary: Vocabulary.Meaningful,
            presentation: PresentationMode.Carousel,
            negation: true,
            negation_explainer: true,
            meta_relations: true,
            stroop: true,
            # Depth 4 with 16-premise leaves yields 287 visible cards, within
            # the renderer's audited 1023-card bound while remaining deeply
            # compositional.
            binary_depth: 4,
            binary_operators: all_binary_operators(),
            sorting_min_width: 4,
            rare_puzzle_permille: 1,
            challenge_enabled: true
        },
        distinction: host_family(true, deadline),
        comparison: host_family(true, deadline),
        temporal: host_family(true, deadline),
        categorical: host_family(true, deadline),
        direction2: host_family(true, deadline),
        direction3: host_family(true, deadline),
        direction4: host_family(true, deadline),
        analogy: host_family(true, deadline),
        binary: host_family(true, deadline),
        sorting: host_family(true, deadline),
        only_analogy: false,
        only_binary: false,
        only_sorting: false,
        sorting_viewport_available: true
    }
