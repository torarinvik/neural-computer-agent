def count_public(question: PublicQuestion) -> i32:
    cursor: mutable RenderCursor = initial_render_cursor()
    count: mutable i32 = 0
    for scan in 0..<2048:
        rebind card: RenderCard?, cursor = next_render_card(cursor, question)
        if card is visible:
            count <- count + 1
    return count

def check_render_streams() -> int error[GenerationError]:
    rng: mutable Rng = rng_from_seed(8080)
    rebind relational: RelationalQuestion, rng = generate_distinction(rng, 5)
    relational_view: PublicRelationalQuestion = public_relational(relational)
    if count_relational(relational_view) != 6:
        return 1
    relational_public: PublicQuestion = public_question(
        Question.Relational(QuestionFamily.Distinction, relational)
    )
    if count_public(relational_public) != 6:
        return 13

    rebind comparison: RelationalQuestion, rng = generate_comparison(rng, 5)
    comparison_public: PublicQuestion = public_question(
        Question.Relational(QuestionFamily.Comparison, comparison)
    )
    if count_public(comparison_public) != 6:
        return 21

    rebind temporal: RelationalQuestion, rng = generate_temporal(rng, 5)
    temporal_public: PublicQuestion = public_question(
        Question.Relational(QuestionFamily.Temporal, temporal)
    )
    if count_public(temporal_public) != 6:
        return 22

    rebind direction2_result: RelationalQuestion error[GenerationError], rng = generate_direction2(rng, 5)
    direction2: RelationalQuestion = try direction2_result
    if count_public(public_question(
        Question.Relational(QuestionFamily.Direction2D, direction2)
    )) != 6:
        return 23

    rebind direction3_result: RelationalQuestion error[GenerationError], rng = generate_direction3(rng, 5)
    direction3: RelationalQuestion = try direction3_result
    if count_public(public_question(
        Question.Relational(QuestionFamily.Direction3D, direction3)
    )) != 6:
        return 24

    rebind direction4_result: RelationalQuestion error[GenerationError], rng = generate_direction4(rng, 5)
    direction4: RelationalQuestion = try direction4_result
    if count_public(public_question(
        Question.Relational(QuestionFamily.Direction4D, direction4)
    )) != 6:
        return 25

    rebind categorical_result: CategoricalQuestion error[GenerationError], rng = generate_categorical(rng, 5)
    categorical: CategoricalQuestion = try categorical_result
    categorical_view: PublicCategoricalQuestion = public_categorical(categorical)
    if count_categorical(categorical_view) != 6:
        return 2
    categorical_public: PublicQuestion = public_question(Question.Categorical(categorical))
    if count_public(categorical_public) != 6:
        return 14

    rebind boolean_result: BooleanQuestion error[GenerationError], rng = generate_boolean(
        rng, 2, 2, all_binary_operators()
    )
    boolean: BooleanQuestion = try boolean_result
    boolean_view: PublicBooleanQuestion = public_boolean(boolean)
    if count_boolean(boolean_view) != 16:
        return 3
    boolean_public: PublicQuestion = public_question(
        Question.Boolean(QuestionFamily.NestedBinary, boolean)
    )
    if count_public(boolean_public) != 16:
        return 15

    rebind analogy_result: AnalogyQuestion error[GenerationError], rng = generate_analogy(rng, 5)
    analogy: AnalogyQuestion = try analogy_result
    analogy_view: PublicAnalogyQuestion = public_analogy(analogy)
    if count_analogy(analogy_view) != 6:
        return 4
    analogy_public: PublicQuestion = public_question(Question.Analogy(analogy))
    if count_public(analogy_public) != 6:
        return 16

    rebind sorting_result: SortingQuestion error[GenerationError], rng = generate_sorting(rng, 7, 2)
    sorting: SortingQuestion = try sorting_result
    sorting_view: PublicSortingQuestion = public_sorting(sorting)
    for i in 0..<sorting_view.card_count:
        card: PublicSortCard = sorting_view.cards[i.usize()]
        visible_attributes: mutable i32 = 0
        if card.color is color:
            visible_attributes <- visible_attributes + 1
        if card.material is material:
            visible_attributes <- visible_attributes + 1
        if card.shape is shape:
            visible_attributes <- visible_attributes + 1
        if card.size is size:
            visible_attributes <- visible_attributes + 1
        if visible_attributes != sorting.key_count:
            return 5
    if count_sorting(sorting_view) != 7:
        return 7
    sorting_public: PublicQuestion = public_question(Question.Sorting(sorting))
    if count_public(sorting_public) != 7:
        return 17

    fixed: FixedPuzzle = FixedPuzzle{
        family: QuestionFamily.Paradox,
        puzzle_id: 0,
        answer: FixedPuzzleAnswer.Undetermined
    }
    fixed_view: PublicFixedPuzzle = public_fixed(fixed)
    if count_fixed(fixed_view) != 3:
        return 8
    fixed_public: PublicQuestion = public_question(Question.Fixed(fixed))
    if count_public(fixed_public) != 3:
        return 18

    challenge_values: mutable array[i32, 16] = zeroed
    challenge_values[0] <- 4
    challenge_values[1] <- 7
    challenge_values[2] <- 9
    challenge: ChallengeData = ChallengeData{
        kind: ChallengeKind.ArithmeticChain,
        values: challenge_values,
        value_count: 3,
        claim: 20,
        answer: 20
    }
    challenge_public: PublicQuestion = public_question(Question.Challenge(challenge))
    if count_public(challenge_public) != 1:
        return 22
    feedback: RenderCard = RenderCard.Feedback(Outcome.Timeout, 300000, -1, 9)
    match feedback:
        RenderCard.Feedback(outcome, elapsed_ms, score, round):
            if outcome != Outcome.Timeout or elapsed_ms != 300000 or score != -1 or round != 9:
                return 19
        _:
            return 20
    for puzzle_id in 0..<12:
        assert puzzle_id >= 0 and puzzle_id < 12
        paradox_count: i32 = fixed_premise_count(QuestionFamily.Paradox, puzzle_id)
        expected_paradox_count: i32 = when puzzle_id:
            0 -> 2
            1 -> 2
            2 -> 2
            3 -> 2
            4 -> 1
            5 -> 2
            6 -> 1
            7 -> 1
            8 -> 2
            9 -> 2
            10 -> 1
            11 -> 1
            _ -> 0
        if paradox_count != expected_paradox_count:
            return 13
        for line in 0..<paradox_count:
            assert line >= 0
            if fixed_premise_text(QuestionFamily.Paradox, puzzle_id, line)[0] == 0:
                return 9
        if fixed_conclusion_text(QuestionFamily.Paradox, puzzle_id)[0] == 0:
            return 10

        logic_count: i32 = fixed_premise_count(QuestionFamily.LogicPuzzle, puzzle_id)
        expected_logic_count: i32 = when puzzle_id:
            0 -> 8
            1 -> 4
            2 -> 7
            3 -> 5
            4 -> 3
            5 -> 5
            6 -> 8
            7 -> 5
            8 -> 4
            9 -> 5
            10 -> 7
            11 -> 6
            _ -> 0
        if logic_count != expected_logic_count:
            return 14
        for line in 0..<logic_count:
            assert line >= 0
            if fixed_premise_text(QuestionFamily.LogicPuzzle, puzzle_id, line)[0] == 0:
                return 11
        if fixed_conclusion_text(QuestionFamily.LogicPuzzle, puzzle_id)[0] == 0:
            return 12
    return 0

def main() -> int:
    catch check_render_streams():
        code:
            return code
        error failure:
            return 99
