include "syllogimous_fixed_text.elisa"

def count_relational(content: PublicRelationalQuestion&) -> i32:
    cursor: mutable RenderCursor = initial_render_cursor()
    count: mutable i32 = 0
    for scan in 0..<64:
        rebind card: RenderCard?, cursor = next_relational_card(cursor, content)
        if card is visible:
            count <- count + 1
    return count

