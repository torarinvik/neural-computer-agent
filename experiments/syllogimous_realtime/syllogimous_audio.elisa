# Deterministic audible rendering of the audited public card stream.
#
# Syllogimous v3 itself is visual-only. The research environment adds this
# learnable tone vocabulary so audio-only and audiovisual streamers can receive
# the same public facts. It is intentionally downstream of `RenderCard`: no
# overload accepts a private Question, truth value, or sorting key.

include "syllogimous_render_stream.elisa"
include "syllogimous_fixed_text.elisa"

extern sin(x: f64) -> f64

global AUDIO_SAMPLE_RATE: i32 = 16000
global AUDIO_SAMPLES_PER_CODE: i32 = 80
global AUDIO_MAX_CODES: i32 = 256
global AUDIO_MAX_SAMPLES: i32 = 20480

struct AudioCodeStream:
    codes: mutable array[i32, 256]
    count: mutable i32 where count >= 0 and count <= 256

struct AudioPacket:
    samples: array[i16, 20480]
    sample_count: i32 where sample_count >= 0 and sample_count <= 20480

struct AudioSynthesis:
    stream: AudioCodeStream
    samples: mutable array[i16, 20480]
    cursor: mutable i32 where cursor >= 0 and cursor <= 256

def empty_audio_codes() -> AudioCodeStream:
    return AudioCodeStream{codes: zeroed, count: 0}

def append_audio_code(stream: lmut AudioCodeStream,
                      code: i32) -> void:
    assert code >= 1 and code <= 8191
    return if stream.count >= 256
    index: i32 = stream.count
    assert index >= 0 and index < 256
    stream.codes[index.usize()] <- code
    stream.count <- stream.count + 1

def linear_audio_code(value: LinearRelation) -> i32:
    return match value:
        LinearRelation.Same: 2000
        LinearRelation.Opposite: 2001
        LinearRelation.More: 2002
        LinearRelation.Less: 2003
        LinearRelation.Before: 2004
        LinearRelation.After: 2005

def planar_audio_code(value: Direction2D) -> i32:
    return match value:
        Direction2D.Same: 2020
        Direction2D.North: 2021
        Direction2D.NorthEast: 2022
        Direction2D.East: 2023
        Direction2D.SouthEast: 2024
        Direction2D.South: 2025
        Direction2D.SouthWest: 2026
        Direction2D.West: 2027
        Direction2D.NorthWest: 2028

def temporal_audio_code(value: TimeRelation) -> i32:
    return match value:
        TimeRelation.Earlier: 2050
        TimeRelation.Simultaneous: 2051
        TimeRelation.Later: 2052

def quantifier_audio_code(value: Quantifier) -> i32:
    return match value:
        Quantifier.All: 2070
        Quantifier.No: 2071
        Quantifier.Some: 2072
        Quantifier.SomeNot: 2073

def relation_audio_code(relation: Relation) -> i32 where result >= 2000 and result <= 2199:
    code: i32 = match relation:
        Relation.Linear(value): linear_audio_code(value)
        Relation.Planar(value): planar_audio_code(value)
        Relation.Spatial(value): 2040
        Relation.SpaceTime(space, time): temporal_audio_code(time)
        Relation.Categorical(value): quantifier_audio_code(value)
        Relation.Meta(source, comparison): 2090 if comparison == MetaRelation.Same else 2091
    assert code >= 2000 and code <= 2199
    return code

def append_premise_audio(stream: lmut AudioCodeStream,
                         premise: PublicPremise&) -> void:
    assert premise.left >= 0 and premise.left < 256
    assert premise.right >= 0 and premise.right < 256
    stream <- append_audio_code(stream, 1000 + premise.left)
    stream <- append_audio_code(stream, relation_audio_code(premise.relation))
    stream <- append_relation_details(stream, premise.relation)
    stream <- append_audio_code(
        stream, 2201 if premise.polarity == Polarity.Negated else 2200
    )
    stream <- append_audio_code(stream, 1000 + premise.right)

def append_signed_audio(stream: lmut AudioCodeStream, value: i32) -> void:
    assert value >= -64 and value <= 64
    stream <- append_audio_code(stream, 2700 + value + 64)

def append_spatial_details(stream: lmut AudioCodeStream,
                           value: Direction3D) -> void:
    match value:
        Direction3D.Same:
            stream <- append_audio_code(stream, 2729)
        Direction3D.Offset(dx, dy, dz):
            stream <- append_signed_audio(stream, dx)
            stream <- append_signed_audio(stream, dy)
            stream <- append_signed_audio(stream, dz)

def append_relation_details(stream: lmut AudioCodeStream,
                            relation: Relation) -> void:
    match relation:
        Relation.Spatial(value):
            stream <- append_spatial_details(stream, value)
        Relation.SpaceTime(space, time):
            stream <- append_spatial_details(stream, space)
        Relation.Meta(source, comparison):
            stream <- append_audio_code(stream, 3000 + source)
        _:
            pass

def append_decimal_audio(stream: lmut AudioCodeStream,
                         value: i32,
                         places: i32 where places >= 1 and places <= 7) -> void:
    magnitude: mutable i32 = -value if value < 0 else value
    stream <- append_audio_code(stream, 2601 if value < 0 else 2600)
    divisor: mutable i32 = 1
    for i in 1..<places:
        divisor <- divisor * 10
    for position in 0..<places:
        digit: i32 = (magnitude / divisor) % 10
        stream <- append_audio_code(stream, 2610 + digit)
        divisor <- divisor / 10 if divisor > 1 else 1

def append_text_audio(stream: lmut AudioCodeStream, text: cstr) -> void:
    cursor: mutable i32 = 0
    while text[cursor.usize()] != 0 and stream.count < 256:
        stream <- append_audio_code(stream, 4000 + text[cursor.usize()].i32())
        cursor <- cursor + 1

def append_sort_audio(stream: lmut AudioCodeStream,
                      card: PublicSortCard&) -> void:
    if card.color is value:
        stream <- append_audio_code(stream, sort_color_audio_code(value))
    if card.material is value:
        stream <- append_audio_code(stream, sort_material_audio_code(value))
    if card.shape is value:
        stream <- append_audio_code(stream, sort_shape_audio_code(value))
    if card.size is value:
        stream <- append_audio_code(stream, sort_size_audio_code(value))

def sort_color_audio_code(value: SortColor) -> i32:
    return match value:
        SortColor.Red: 2300
        SortColor.Orange: 2301
        SortColor.Yellow: 2302
        SortColor.Green: 2303
        SortColor.Blue: 2304
        SortColor.Indigo: 2305
        SortColor.Violet: 2306

def sort_material_audio_code(value: SortMaterial) -> i32:
    return match value:
        SortMaterial.Wood: 2320
        SortMaterial.Copper: 2321
        SortMaterial.Silver: 2322
        SortMaterial.Gold: 2323
        SortMaterial.Platinum: 2324

def sort_shape_audio_code(value: SortShape) -> i32:
    return match value:
        SortShape.Dot: 2340
        SortShape.Line: 2341
        SortShape.Triangle: 2342
        SortShape.Square: 2343
        SortShape.Pentagon: 2344
        SortShape.Hexagon: 2345
        SortShape.Heptagon: 2346
        SortShape.Octagon: 2347
        SortShape.Nonagon: 2348
        SortShape.Decagon: 2349
        SortShape.Hendecagon: 2350
        SortShape.Dodecagon: 2351

def sort_size_audio_code(value: SortSize) -> i32:
    return match value:
        SortSize.Small: 2370
        SortSize.Medium: 2371
        SortSize.Large: 2372
        SortSize.ExtraLarge: 2373
        SortSize.ExtraExtraLarge: 2374

def binary_operator_audio_code(value: BinaryOperator) -> i32:
    return match value:
        BinaryOperator.And: 2400
        BinaryOperator.Nand: 2401
        BinaryOperator.Or: 2402
        BinaryOperator.Nor: 2403
        BinaryOperator.Xor: 2404
        BinaryOperator.Xnor: 2405

