    return match value:
        ChallengeKind.ArithmeticChain: 2600
        ChallengeKind.InequalityChain: 2601
        ChallengeKind.Parity: 2602
        ChallengeKind.Sequence: 2603
        ChallengeKind.GraphReachability: 2604
        ChallengeKind.GraphDistance: 2605
        ChallengeKind.TemporalOrder: 2606
        ChallengeKind.Membership: 2607
        ChallengeKind.BooleanFormula: 2608
        ChallengeKind.ConstraintAssignment: 2609
        ChallengeKind.MinimumValue: 2610
        ChallengeKind.MaximumValue: 2611
        ChallengeKind.AbsoluteDifference: 2612
        ChallengeKind.SetIntersection: 2613
        ChallengeKind.GraphCycle: 2614
        ChallengeKind.TopologicalOrder: 2615
        ChallengeKind.CalendarOffset: 2616
        ChallengeKind.XorFormula: 2617
        ChallengeKind.LinearEquation: 2618
        ChallengeKind.DigitCount: 2619
        ChallengeKind.ThreePremiseChain: 2620
        ChallengeKind.FourPremiseChain: 2621
        ChallengeKind.DistractorCheck: 2622
        ChallengeKind.ContradictionCheck: 2623
        ChallengeKind.Biconditional: 2624
        ChallengeKind.UnlessRule: 2625
        ChallengeKind.OnlyIfRule: 2626
        ChallengeKind.QuantifierAll: 2627
        ChallengeKind.QuantifierSome: 2628
        ChallengeKind.ExclusiveOr: 2629
        ChallengeKind.TransitiveRelation: 2630
        ChallengeKind.SymmetricRelation: 2631
        ChallengeKind.DoubleNegation: 2632
        ChallengeKind.EarliestEvent: 2633
        ChallengeKind.LatestEvent: 2634
        ChallengeKind.PartialOrder: 2635
        ChallengeKind.GridDistance: 2636
        ChallengeKind.ManhattanPath: 2637
        ChallengeKind.Rotation: 2638
        ChallengeKind.Mirror: 2639
        ChallengeKind.SumValues: 2640
        ChallengeKind.ProductValues: 2641
        ChallengeKind.AverageFloor: 2642
        ChallengeKind.ValueRange: 2643
        ChallengeKind.SignCheck: 2644
        ChallengeKind.Divisibility: 2645
        ChallengeKind.ModuloCheck: 2646
        ChallengeKind.PowerOfTwo: 2647
        ChallengeKind.CountTrue: 2648
        ChallengeKind.Majority: 2649
        ChallengeKind.AtLeast: 2650
        ChallengeKind.ExactlyOne: 2651
        ChallengeKind.ImplicationChain: 2652
        ChallengeKind.NandFormula: 2653
        ChallengeKind.NorFormula: 2654
        ChallengeKind.MinimumIndex: 2655
        ChallengeKind.MaximumIndex: 2656
        ChallengeKind.StableSortCheck: 2657
        ChallengeKind.PermutationParity: 2658
        ChallengeKind.UniqueValue: 2659
        ChallengeKind.AllDistinct: 2660
        ChallengeKind.PairwiseOrder: 2661
        ChallengeKind.MedianValue: 2662
        ChallengeKind.SecondMinimum: 2663
        ChallengeKind.SecondMaximum: 2664
        ChallengeKind.CountLess: 2665
        ChallengeKind.CountGreater: 2666
        ChallengeKind.WeightedSum: 2667
        ChallengeKind.LinearInequality: 2668
        ChallengeKind.IntervalMembership: 2669
        ChallengeKind.TemporalGap: 2670
        ChallengeKind.ScheduleConflict: 2671
        ChallengeKind.ReachTwoSteps: 2672
        ChallengeKind.DegreeCount: 2673
        ChallengeKind.BipartiteCheck: 2674
        ChallengeKind.PathParity: 2675
        ChallengeKind.CoordinateQuadrant: 2676
        ChallengeKind.CompassDirection: 2677
        ChallengeKind.Rotation3D: 2678
        ChallengeKind.SpaceTimeOrder: 2679
        ChallengeKind.AllOf: 2680
        ChallengeKind.AnyOf: 2681
        ChallengeKind.NoneOf: 2682
        ChallengeKind.ExactlyK: 2683
        ChallengeKind.SyllogismMood: 2684
        ChallengeKind.AnalogyRelation: 2685
        ChallengeKind.SortingKey: 2686
        ChallengeKind.PermutationCheck: 2687
        ChallengeKind.ConstraintCount: 2688
        ChallengeKind.CompositeProof: 2689

def audio_codes_for_card(card: RenderCard) -> AudioCodeStream:
    stream: mutable AudioCodeStream = empty_audio_codes()
    match card:
        RenderCard.NegationExplainer:
            stream <- append_audio_code(stream, 11)
            stream <- append_text_audio(stream, "INVERT THE RED TEXT".cast[cstr])
        RenderCard.Premise(index, total, content):
            stream <- append_audio_code(stream, 1)
            stream <- append_audio_code(stream, 3000 + index)
            stream <- append_audio_code(stream, 3100 + total)
            stream <- append_premise_audio(stream, content)
        RenderCard.Conclusion(content):
            stream <- append_audio_code(stream, 2)
            stream <- append_premise_audio(stream, content)
        RenderCard.BooleanPremise(atom, index, total, content):
            stream <- append_audio_code(stream, 3)
            stream <- append_audio_code(stream, 3000 + atom)
            stream <- append_audio_code(stream, 3100 + index)
            stream <- append_audio_code(stream, 3100 + total)
            stream <- append_premise_audio(stream, content)
        RenderCard.BooleanNode(index, total, content):
            stream <- append_audio_code(stream, 4)
            stream <- append_audio_code(stream, 3000 + index)
            stream <- append_audio_code(stream, 3100 + total)
            match content:
                PublicExpressionSummary.RelationalLeaf(conclusion):
                    stream <- append_premise_audio(stream, conclusion)
                PublicExpressionSummary.CategoricalLeaf(conclusion):
                    stream <- append_premise_audio(stream, conclusion)
                PublicExpressionSummary.Apply(op, left, right):
                    stream <- append_audio_code(stream, binary_operator_audio_code(op))
                    stream <- append_audio_code(stream, 3000 + left)
                    stream <- append_audio_code(stream, 3000 + right)
        RenderCard.BooleanConclusion:
            stream <- append_audio_code(stream, 5)
        RenderCard.AnalogyConclusion(first_left, first_right,
                                     second_left, second_right, claimed_same):
            stream <- append_audio_code(stream, 6)
            stream <- append_audio_code(stream, 1000 + first_left)
            stream <- append_audio_code(stream, 1000 + first_right)
            stream <- append_audio_code(stream, 1000 + second_left)
            stream <- append_audio_code(stream, 1000 + second_right)
            stream <- append_audio_code(
                stream, 2420 if claimed_same == Truth.True else 2421
            )
        RenderCard.SortingCard(index, total, content):
            stream <- append_audio_code(stream, 7)
            stream <- append_audio_code(stream, 3000 + index)
            stream <- append_audio_code(stream, 3100 + total)
            stream <- append_sort_audio(stream, content)
        RenderCard.Challenge(content):
            stream <- append_audio_code(stream, 12)
            stream <- append_audio_code(stream, challenge_kind_audio_code(content.kind))
            for i in 0..<content.value_count:
                stream <- append_decimal_audio(stream, content.values[i.usize()], 6)
        RenderCard.FixedPremise(family, puzzle_id, line):
            assert puzzle_id >= 0 and puzzle_id < 12
            assert line >= 0
            stream <- append_audio_code(stream, 8)
            stream <- append_text_audio(
                stream, fixed_premise_text(family, puzzle_id, line)
            )
        RenderCard.FixedConclusion(family, puzzle_id):
            assert puzzle_id >= 0 and puzzle_id < 12
            stream <- append_audio_code(stream, 9)
            stream <- append_text_audio(
                stream, fixed_conclusion_text(family, puzzle_id)
            )
        RenderCard.Feedback(outcome, elapsed_ms, score, round):
            stream <- append_audio_code(stream, 10)
            match outcome:
                Outcome.Correct:
                    stream <- append_audio_code(stream, 2500)
                Outcome.Wrong:
                    stream <- append_audio_code(stream, 2501)
                Outcome.Timeout:
                    stream <- append_audio_code(stream, 2502)
            stream <- append_decimal_audio(stream, elapsed_ms, 6)
            stream <- append_decimal_audio(stream, score, 4)
            stream <- append_decimal_audio(stream, round, 4)
    return stream

def audio_current(context: AudioSynthesis&) -> i32:
    assert context.cursor >= 0 and context.cursor < context.stream.count
    return context.stream.codes[context.cursor.usize()]

def clamp_audio_sample(value: i32) -> i16:
    bounded: i32 = -32768 if value < -32768 else (
        32767 if value > 32767 else value
    )
    return bounded.i16()

def synthesize_audio_code(context: lmut AudioSynthesis,
                          code: i32) -> void:
    assert context.cursor >= 0 and context.cursor < 256
    base: i32 = context.cursor * AUDIO_SAMPLES_PER_CODE
    low_frequency: f64 = 180.0 + (code % 64).f64() * 10.0
    high_frequency: f64 = 1000.0 + ((code / 64) % 128).f64() * 15.0
    for offset in 0..<AUDIO_SAMPLES_PER_CODE:
        low_phase: f64 = 6.283185307179586 * low_frequency * offset.f64() / 16000.0
        high_phase: f64 = 6.283185307179586 * high_frequency * offset.f64() / 16000.0
        amplitude: f64 = 0.0 if offset >= 72 else 2600.0
        context.samples[(base + offset).usize()] <- clamp_audio_sample(
            (amplitude * sin(low_phase) + amplitude * sin(high_phase)).i32()
        )
    context.cursor <- context.cursor + 1

def synthesize_audio(stream: AudioCodeStream) -> AudioPacket:
    context: mutable AudioSynthesis = AudioSynthesis{
        stream: stream,
        samples: zeroed,
        cursor: 0
    }
    machine over audio_current(context) while context.cursor < context.stream.count:
        state Scan
        start Scan

        Scan, code:
            context <- synthesize_audio_code(context, code)
            -> Scan
    sample_count_raw: i32 = context.stream.count * AUDIO_SAMPLES_PER_CODE
    assert sample_count_raw >= 0 and sample_count_raw <= 20480
    sample_count: i32 where sample_count >= 0 and sample_count <= 20480 = sample_count_raw
    return AudioPacket{samples: context.samples, sample_count: sample_count}

def render_card_audio(card: RenderCard) -> AudioPacket:
    return synthesize_audio(audio_codes_for_card(card))
