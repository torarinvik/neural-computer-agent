# Public, model-visible question representation. None of these ADTs has a
# `truth`, `answer`, expected sorting order, or hidden sorting key field.

include "syllogimous_presentation.elisa"

struct PublicPremise:
    left: i32 where left >= 0 and left < 256
    relation: Relation
    right: i32 where right >= 0 and right < 256
    polarity: Polarity

struct PublicRelationalQuestion:
    premises: array[PublicPremise, 32]
    premise_count: i32 where premise_count >= 2 and premise_count <= 32
    conclusion: PublicPremise

struct PublicCategoricalQuestion:
    premises: array[PublicPremise, 32]
    premise_count: i32 where premise_count >= 2 and premise_count <= 32
    conclusion: PublicPremise

enum PublicBaseQuestion:
    Relational(question: PublicRelationalQuestion)
    Categorical(question: PublicCategoricalQuestion)

enum PublicExpressionNode:
    Leaf(base: i32 where base >= 0 and base < 256)
    Apply(op: BinaryOperator,
          left: i32 where left >= 0 and left < 511,
          right: i32 where right >= 0 and right < 511)

struct PublicBooleanQuestion:
    bases: array[PublicBaseQuestion, 256]
    base_count: i32 where base_count >= 1 and base_count <= 256
    nodes: array[PublicExpressionNode, 511]
    node_count: i32 where node_count >= 1 and node_count <= 511
    root: i32 where root >= 0 and root < 511

struct PublicAnalogyQuestion:
    family: QuestionFamily
    premises: array[PublicPremise, 32]
    premise_count: i32 where premise_count >= 2 and premise_count <= 32
    first_left: i32 where first_left >= 0 and first_left < 256
    first_right: i32 where first_right >= 0 and first_right < 256
    second_left: i32 where second_left >= 0 and second_left < 256
    second_right: i32 where second_right >= 0 and second_right < 256
    # This is the visible claim the player evaluates, not the hidden answer.
    claimed_same: Truth

struct PublicSortCard:
    color: SortColor?
    material: SortMaterial?
    shape: SortShape?
    size: SortSize?

struct PublicSortingQuestion:
    cards: array[PublicSortCard, 34]
    card_count: i32 where card_count >= 4 and card_count <= 34

struct PublicChallenge:
    kind: ChallengeKind
    values: array[i32, 16]
    value_count: i32 where value_count >= 1 and value_count <= 16
    claim: i32

struct PublicFixedPuzzle:
    family: QuestionFamily
    puzzle_id: i32 where puzzle_id >= 0 and puzzle_id < 12

enum PublicQuestion:
    Relational(family: QuestionFamily, content: PublicRelationalQuestion)
    Categorical(content: PublicCategoricalQuestion)
    Boolean(family: QuestionFamily, content: PublicBooleanQuestion)
    Analogy(content: PublicAnalogyQuestion)
    Sorting(content: PublicSortingQuestion)
    Challenge(content: PublicChallenge)
    Fixed(content: PublicFixedPuzzle)

def public_premise(item: Premise&) -> PublicPremise:
    assert item.left >= 0 and item.left < 256
    assert item.right >= 0 and item.right < 256
    return PublicPremise{
        left: item.left,
        relation: item.relation,
        right: item.right,
        polarity: item.polarity
    }

def public_relational(question: RelationalQuestion&) -> PublicRelationalQuestion:
    assert question.premise_count >= 2 and question.premise_count <= 32
    premise_count: i32 where premise_count >= 2 and premise_count <= 32 = question.premise_count
    premises: mutable array[PublicPremise, 32] = zeroed
    for i in 0..<premise_count:
        premises[i.usize()] <- public_premise(question.premises[i.usize()])
    return PublicRelationalQuestion{
        premises: premises,
        premise_count: premise_count,
        conclusion: public_premise(question.conclusion)
    }

def public_categorical(question: CategoricalQuestion&) -> PublicCategoricalQuestion:
    assert question.premise_count >= 2 and question.premise_count <= 32
    premise_count: i32 where premise_count >= 2 and premise_count <= 32 = question.premise_count
    premises: mutable array[PublicPremise, 32] = zeroed
    for i in 0..<premise_count:
        premises[i.usize()] <- public_premise(question.premises[i.usize()])
    return PublicCategoricalQuestion{
        premises: premises,
        premise_count: premise_count,
        conclusion: public_premise(question.conclusion)
    }

def public_boolean(question: BooleanQuestion&) -> PublicBooleanQuestion:
    assert question.base_count >= 1 and question.base_count <= 256
    assert question.node_count >= 1 and question.node_count <= 511
    base_count: i32 where base_count >= 1 and base_count <= 256 = question.base_count
    node_count: i32 where node_count >= 1 and node_count <= 511 = question.node_count
    assert question.root >= 0 and question.root < 511
    root: i32 where root >= 0 and root < 511 = question.root
    bases: mutable array[PublicBaseQuestion, 256] = zeroed
    for i in 0..<base_count:
        match question.bases[i.usize()]:
            BaseQuestion.Relational(atom):
                bases[i.usize()] <- PublicBaseQuestion.Relational(
                    public_relational(atom)
                )
            BaseQuestion.Categorical(atom):
                bases[i.usize()] <- PublicBaseQuestion.Categorical(
                    public_categorical(atom)
                )
    nodes: mutable array[PublicExpressionNode, 511] = zeroed
    for i in 0..<node_count:
        match question.nodes[i.usize()]:
            ExpressionNode.Leaf(base):
                nodes[i.usize()] <- PublicExpressionNode.Leaf(base)
            ExpressionNode.Apply(op, left, right):
                nodes[i.usize()] <- PublicExpressionNode.Apply(op, left, right)
    return PublicBooleanQuestion{
        bases: bases,
        base_count: base_count,
        nodes: nodes,
        node_count: node_count,
        root: root
    }

def public_analogy(question: AnalogyQuestion&) -> PublicAnalogyQuestion:
    evidence: PublicRelationalQuestion = public_relational(question.evidence)
    assert evidence.premise_count >= 2 and evidence.premise_count <= 32
    assert question.first.left >= 0 and question.first.left < 256
    assert question.first.right >= 0 and question.first.right < 256
    assert question.second.left >= 0 and question.second.left < 256
    assert question.second.right >= 0 and question.second.right < 256
    premise_count: i32 where premise_count >= 2 and premise_count <= 32 = evidence.premise_count
    first_left: i32 where first_left >= 0 and first_left < 256 = question.first.left
    first_right: i32 where first_right >= 0 and first_right < 256 = question.first.right
    second_left: i32 where second_left >= 0 and second_left < 256 = question.second.left
    second_right: i32 where second_right >= 0 and second_right < 256 = question.second.right
    return PublicAnalogyQuestion{
        family: question.family,
        premises: evidence.premises,
        premise_count: premise_count,
        first_left: first_left,
        first_right: first_right,
        second_left: second_left,
        second_right: second_right,
        claimed_same: question.claimed_same
    }

def public_sorting(question: SortingQuestion&) -> PublicSortingQuestion:
    assert question.card_count >= 4 and question.card_count <= 34
    card_count: i32 where card_count >= 4 and card_count <= 34 = question.card_count
    cards: mutable array[PublicSortCard, 34] = zeroed
    for i in 0..<card_count:
        source: SortCard = question.cards[i.usize()]
        color: mutable SortColor? = null
        material: mutable SortMaterial? = null
        shape: mutable SortShape? = null
        size: mutable SortSize? = null
        color <- source.color if source.active[0]
        material <- source.material if source.active[1]
        shape <- source.shape if source.active[2]
        size <- source.size if source.active[3]
        cards[i.usize()] <- PublicSortCard{
            color: color,
            material: material,
            shape: shape,
            size: size
        }
    return PublicSortingQuestion{cards: cards, card_count: card_count}

def public_fixed(question: FixedPuzzle&) -> PublicFixedPuzzle:
    assert question.puzzle_id >= 0 and question.puzzle_id < 12
    puzzle_id: i32 where puzzle_id >= 0 and puzzle_id < 12 = question.puzzle_id
    return PublicFixedPuzzle{family: question.family, puzzle_id: puzzle_id}

def public_challenge(question: ChallengeData&) -> PublicChallenge:
    assert question.value_count >= 1 and question.value_count <= 16
    return PublicChallenge{
        kind: question.kind,
        values: question.values,
        value_count: question.value_count,
        claim: question.claim
    }

# This is the only permitted conversion from private evaluator state into a
# renderer-facing question. Exhaustive matching makes additions to `Question`
# fail visibly until their answer-free public representation is defined.
def public_question(question: Question) -> PublicQuestion:
    return match question:
        Question.Relational(family, content):
            PublicQuestion.Relational(
                family, public_relational(content)
            )
        Question.Categorical(content):
            PublicQuestion.Categorical(public_categorical(content))
        Question.Boolean(family, content):
            PublicQuestion.Boolean(family, public_boolean(content))
        Question.Analogy(content):
            PublicQuestion.Analogy(public_analogy(content))
        Question.Sorting(content):
            PublicQuestion.Sorting(public_sorting(content))
        Question.Challenge(content):
            PublicQuestion.Challenge(public_challenge(content))
        Question.Fixed(content):
            PublicQuestion.Fixed(public_fixed(content))
