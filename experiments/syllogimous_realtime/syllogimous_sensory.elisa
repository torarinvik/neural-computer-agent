# Single public audiovisual boundary for a visible card.
#
# `raster_render_card` writes the 640x400 RGB frame into Encoder::SCREEN_GRAB;
# the returned packet contains only synchronized PCM and timing metadata. A
# caller may serialize/read those two raw streams, but cannot obtain Question,
# EpisodeTask, expected truth, or expected sorting order through this API.

include "syllogimous_raster.elisa"
include "syllogimous_audio.elisa"

struct SensoryPacket:
    pcm: array[i16, 20480]
    pcm_count: i32 where pcm_count >= 0 and pcm_count <= 20480
    timestamp_ms: i64 where timestamp_ms >= 0
    width: i32 where width == 640
    height: i32 where height == 400

def render_sensory_packet(card: RenderCard,
                          lexicon: EntityLexicon&,
                          presentation: PresentationFrame&,
                          remaining_permille: i32 where remaining_permille >= 0 and remaining_permille <= 1000,
                          timestamp_ms: i64 where timestamp_ms >= 0) -> SensoryPacket:
    raster_render_card(card, lexicon, presentation, remaining_permille)
    audio: AudioPacket = render_card_audio(card)
    assert audio.sample_count >= 0 and audio.sample_count <= 20480
    return SensoryPacket{
        pcm: audio.samples,
        pcm_count: audio.sample_count,
        timestamp_ms: timestamp_ms,
        width: 640,
        height: 400
    }
