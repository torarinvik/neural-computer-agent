# Native bitmap raster primitives for audited public render cards.

include "../../encoder.elisa"
include "syllogimous_fixed_text.elisa"

global RASTER_W: i32 = 640
global RASTER_H: i32 = 400
global mutable FONT_ROWS: array[u8, 280] = [
    0,0,0,0,0,0,0,14,17,17,31,17,17,17,30,17,17,30,17,17,30,15,16,16,16,16,16,15,
    30,17,17,17,17,17,30,31,16,16,30,16,16,31,31,16,16,30,16,16,16,15,16,16,23,17,17,15,
    17,17,17,31,17,17,17,31,4,4,4,4,4,31,7,2,2,2,18,18,12,17,18,20,24,20,18,17,
    16,16,16,16,16,16,31,17,27,21,21,17,17,17,17,25,21,19,17,17,17,14,17,17,17,17,17,14,
    30,17,17,30,16,16,16,14,17,17,17,21,18,13,30,17,17,30,20,18,17,15,16,16,14,1,1,30,
    31,4,4,4,4,4,4,17,17,17,17,17,17,14,17,17,17,17,17,10,4,17,17,17,21,21,21,10,
    17,17,10,4,10,17,17,17,17,10,4,4,4,4,31,1,2,4,8,16,31,14,17,19,21,25,17,14,
    4,12,4,4,4,4,14,14,17,1,2,4,8,31,30,1,1,14,1,1,30,2,6,10,18,31,2,2,
    31,16,16,30,1,1,30,6,8,16,30,17,17,14,31,1,2,4,8,8,8,14,17,17,14,17,17,14,
    14,17,17,15,1,2,28,0,0,0,31,0,0,0,1,2,2,4,8,8,16,0,4,4,0,4,4,0
]

def glyph_index(code: u8) -> i32:
    return match code:
        32: 0
        65: 1
        66: 2
        67: 3
        68: 4
        69: 5
        70: 6
        71: 7
        72: 8
        73: 9
        74: 10
        75: 11
        76: 12
        77: 13
        78: 14
        79: 15
        80: 16
        81: 17
        82: 18
        83: 19
        84: 20
        85: 21
        86: 22
        87: 23
        88: 24
        89: 25
        90: 26
        48: 27
        49: 28
        50: 29
        51: 30
        52: 31
        53: 32
        54: 33
        55: 34
        56: 35
        57: 36
        45: 37
        47: 38
        58: 39
        _: 0

def raster_fill(color: u32) -> void:
    for i in 0..<(RASTER_W * RASTER_H):
        Encoder::SCREEN_GRAB[i.usize()] <- color

def raster_rect(x: i32, y: i32, width: i32, height: i32, color: u32) -> void:
    for yy in y..<(y + height):
        if yy >= 0 and yy < RASTER_H:
            for xx in x..<(x + width):
                if xx >= 0 and xx < RASTER_W:
                    Encoder::SCREEN_GRAB[(yy * RASTER_W + xx).usize()] <- color

def raster_glyph(x: i32, y: i32, scale: i32, code: u8, color: u32) -> void:
    glyph: i32 = glyph_index(code)
    for row in 0..<7:
        bits: u8 = FONT_ROWS[(glyph * 7 + row).usize()]
        for col in 0..<5:
            if ((bits >> (4 - col).u8()) & 1) == 1:
                raster_rect(x + col * scale, y + row * scale, scale, scale, color)

def raster_text(x: i32, y: i32, scale: i32, value: cstr, color: u32) -> void:
    cursor: mutable i32 = 0
    while value[cursor.usize()] != 0:
        code: u8 = value[cursor.usize()]
        upper: u8 = code - 32 if code >= 97 and code <= 122 else code
        raster_glyph(x + cursor * 6 * scale, y, scale, upper, color)
        cursor <- cursor + 1

def raster_text_wrapped(x: i32, y: i32,
                        scale: i32 where scale >= 1 and scale <= 4,
                        value: cstr,
                        columns: i32 where columns >= 8 and columns <= 100,
                        color: u32) -> void:
    cursor: mutable i32 = 0
    column: mutable i32 = 0
    row: mutable i32 = 0
    while value[cursor.usize()] != 0:
        code: u8 = value[cursor.usize()]
        if code == 10 or column >= columns:
            row <- row + 1
            column <- 0
        if code != 10:
            upper: u8 = code - 32 if code >= 97 and code <= 122 else code
            raster_glyph(x + column * 6 * scale,
                         y + row * 9 * scale,
                         scale, upper, color)
            column <- column + 1
        cursor <- cursor + 1

def raster_number(x: i32, y: i32, scale: i32, value: i32, color: u32) -> void:
    base_x: mutable i32 = x
    magnitude: mutable i32 = value
    if magnitude < 0:
        raster_glyph(base_x, y, scale, 45, color)
        magnitude <- -magnitude
        base_x <- base_x + 6 * scale
    hundreds: i32 = (magnitude / 100) % 10
    tens: i32 = (magnitude / 10) % 10
    ones: i32 = magnitude % 10
    raster_glyph(base_x, y, scale, (48 + hundreds).u8(), color) if magnitude >= 100
    raster_glyph(base_x + (6 * scale if magnitude >= 100 else 0), y, scale, (48 + tens).u8(), color) if magnitude >= 10
    offset: i32 = (12 * scale if magnitude >= 100 else (6 * scale if magnitude >= 10 else 0))
    raster_glyph(base_x + offset, y, scale, (48 + ones).u8(), color)

def consonant_code(value: AbstractConsonant) -> u8:
    return match value:
        AbstractConsonant.Q: 81
        AbstractConsonant.W: 87
        AbstractConsonant.R: 82
        AbstractConsonant.T: 84
        AbstractConsonant.P: 80
        AbstractConsonant.S: 83
        AbstractConsonant.D: 68
        AbstractConsonant.F: 70
        AbstractConsonant.G: 71
        AbstractConsonant.K: 75
        AbstractConsonant.L: 76
        AbstractConsonant.Z: 90
        AbstractConsonant.X: 88
        AbstractConsonant.C: 67
        AbstractConsonant.V: 86
        AbstractConsonant.B: 66
        AbstractConsonant.N: 78
        AbstractConsonant.M: 77

def vowel_code(value: AbstractVowel) -> u8:
    return match value:
        AbstractVowel.A: 65
        AbstractVowel.E: 69
        AbstractVowel.I: 73
        AbstractVowel.O: 79
        AbstractVowel.U: 85

def raster_entity(x: i32, y: i32, lexicon: EntityLexicon&,
                  entity: i32 where entity >= 0 and entity < lexicon.entity_count,
                  color: u32) -> void:
    raster_rect(x - 8, y - 10, 196, 48, 0x23313c)
    raster_rect(x - 5, y - 7, 190, 42, 0x0a0e12)
    match lexicon.labels[entity.usize()]:
        EntityLabel.Meaningful(index):
            assert index >= 0 and index < 446
            noun_index: i32 where noun_index >= 0 and noun_index < 446 = index
            raster_text(x, y, 2, meaningful_noun(noun_index), color)
        EntityLabel.Abstract(index):
            assert index >= 0 and index < 1530
            abstract_index: i32 where abstract_index >= 0 and abstract_index < 1530 = index
            syllable: AbstractSyllable = decode_abstract_label(abstract_index)
            raster_glyph(x + 42, y, 4, consonant_code(syllable.first), color)
            raster_glyph(x + 66, y, 4, vowel_code(syllable.vowel), color)
            raster_glyph(x + 90, y, 4, consonant_code(syllable.last), color)

def linear_name(value: LinearRelation) -> cstr:
    return match value:
        LinearRelation.Same: "SAME AS"
        LinearRelation.Opposite: "OPPOSITE OF"
        LinearRelation.More: "MORE THAN"
        LinearRelation.Less: "LESS THAN"
        LinearRelation.Before: "BEFORE"
        LinearRelation.After: "AFTER"

def planar_name(value: Direction2D) -> cstr:
    return match value:
        Direction2D.Same: "SAME PLACE"
        Direction2D.North: "NORTH OF"
        Direction2D.NorthEast: "NORTH EAST OF"
        Direction2D.East: "EAST OF"
        Direction2D.SouthEast: "SOUTH EAST OF"
        Direction2D.South: "SOUTH OF"
        Direction2D.SouthWest: "SOUTH WEST OF"
        Direction2D.West: "WEST OF"
        Direction2D.NorthWest: "NORTH WEST OF"

def quantifier_name(value: Quantifier) -> cstr:
    return match value:
        Quantifier.All: "ALL ARE"
        Quantifier.No: "NO ARE"
        Quantifier.Some: "SOME ARE"
        Quantifier.SomeNot: "SOME ARE NOT"

def time_name(value: TimeRelation) -> cstr:
    return match value:
        TimeRelation.Earlier: "EARLIER"
        TimeRelation.Simultaneous: "SAME TIME"
        TimeRelation.Later: "LATER"

def raster_relation(x: i32, y: i32, relation: Relation,
                    polarity: Polarity, color: u32, negated_color: u32) -> void:
    ink: u32 = negated_color if polarity == Polarity.Negated else color
    raster_text(x, y, 1, "NOT", negated_color) if polarity == Polarity.Negated
    relation_y: i32 = y + 12 if polarity == Polarity.Negated else y
    match relation:
        Relation.Linear(value):
            raster_text(x, relation_y, 1, linear_name(value), ink)
        Relation.Planar(value):
            raster_text(x, relation_y, 1, planar_name(value), ink)
        Relation.Spatial(value):
            raster_text(x, relation_y, 1, "3D", ink)
            match value:
                Direction3D.Same:
                    raster_text(x, relation_y + 12, 1, "SAME PLACE", ink)
                Direction3D.Offset(dx, dy, dz):
                    raster_text(x, relation_y + 12, 1, "X", ink)
                    raster_number(x + 12, relation_y + 12, 1, dx, ink)
                    raster_text(x + 42, relation_y + 12, 1, "Y", ink)
                    raster_number(x + 54, relation_y + 12, 1, dy, ink)
                    raster_text(x + 84, relation_y + 12, 1, "Z", ink)
                    raster_number(x + 96, relation_y + 12, 1, dz, ink)
        Relation.SpaceTime(space, time):
            raster_text(x, relation_y, 1, time_name(time), ink)
            match space:
                Direction3D.Same:
                    raster_text(x, relation_y + 12, 1, "SAME PLACE", ink)
                Direction3D.Offset(dx, dy, dz):
                    raster_text(x, relation_y + 12, 1, "X", ink)
                    raster_number(x + 12, relation_y + 12, 1, dx, ink)
                    raster_text(x + 42, relation_y + 12, 1, "Y", ink)
                    raster_number(x + 54, relation_y + 12, 1, dy, ink)
                    raster_text(x + 84, relation_y + 12, 1, "Z", ink)
                    raster_number(x + 96, relation_y + 12, 1, dz, ink)
        Relation.Categorical(value):
            raster_text(x, relation_y, 1, quantifier_name(value), ink)
        Relation.Meta(source, comparison):
            raster_text(x, relation_y, 1,
                        "SAME AS PREMISE" if comparison == MetaRelation.Same else "OPPOSITE OF PREMISE",
                        ink)
            raster_number(x + 108, relation_y + 12, 1, source + 1, ink)

def raster_premise(content: PublicPremise&, lexicon: EntityLexicon&,
                    frame: PresentationFrame&) -> void:
    assert content.left < lexicon.entity_count
    assert content.right < lexicon.entity_count
    left: i32 where left >= 0 and left < lexicon.entity_count = content.left
    right: i32 where right >= 0 and right < lexicon.entity_count = content.right
    body: u32 = 0xff3030 if frame.body_ink == InkColor.Red else 0xf0f4f5
    negated: u32 = 0xff3030 if frame.negated_ink == InkColor.Red else 0xf0f4f5
    raster_entity(18, 156, lexicon, left, body)
    raster_entity(434, 156, lexicon, right, body)
    raster_relation(230, 150, content.relation, content.polarity, body, negated)

def binary_operator_name(value: BinaryOperator) -> cstr:
    return match value:
        BinaryOperator.And: "AND"
        BinaryOperator.Nand: "NAND"
        BinaryOperator.Or: "OR"
        BinaryOperator.Nor: "NOR"
        BinaryOperator.Xor: "XOR"
        BinaryOperator.Xnor: "XNOR"

def sort_color_name(value: SortColor) -> cstr:
    return match value:
        SortColor.Red: "RED"
        SortColor.Orange: "ORANGE"
        SortColor.Yellow: "YELLOW"
        SortColor.Green: "GREEN"
        SortColor.Blue: "BLUE"
        SortColor.Indigo: "INDIGO"
        SortColor.Violet: "VIOLET"

def sort_material_name(value: SortMaterial) -> cstr:
    return match value:
        SortMaterial.Wood: "WOOD"
        SortMaterial.Copper: "COPPER"
        SortMaterial.Silver: "SILVER"
        SortMaterial.Gold: "GOLD"
        SortMaterial.Platinum: "PLATINUM"

def sort_shape_name(value: SortShape) -> cstr:
    return match value:
        SortShape.Dot: "DOT"
        SortShape.Line: "LINE"
        SortShape.Triangle: "TRIANGLE"
        SortShape.Square: "SQUARE"
        SortShape.Pentagon: "PENTAGON"
        SortShape.Hexagon: "HEXAGON"
        SortShape.Heptagon: "7-GON"
        SortShape.Octagon: "8-GON"
        SortShape.Nonagon: "9-GON"
        SortShape.Decagon: "10-GON"
        SortShape.Hendecagon: "11-GON"
        SortShape.Dodecagon: "12-GON"

def sort_size_name(value: SortSize) -> cstr:
    return match value:
        SortSize.Small: "SMALL"
        SortSize.Medium: "MEDIUM"
        SortSize.Large: "LARGE"
        SortSize.ExtraLarge: "XLARGE"
        SortSize.ExtraExtraLarge: "XXLARGE"

def raster_sort_card(content: PublicSortCard&, color: u32) -> void:
    y: mutable i32 = 112
    if content.color is value:
        raster_text(170, y, 3, sort_color_name(value), color)
        y <- y + 34
    if content.material is value:
        raster_text(170, y, 3, sort_material_name(value), color)
        y <- y + 34
    if content.shape is value:
        raster_text(170, y, 3, sort_shape_name(value), color)
        y <- y + 34
    if content.size is value:
        raster_text(170, y, 3, sort_size_name(value), color)

def raster_buttons(frame: PresentationFrame&) -> void:
    true_x: i32 = 214 if frame.state.button_order == ButtonOrder.TrueFirst else 346
    false_x: i32 = 346 if frame.state.button_order == ButtonOrder.TrueFirst else 214
    true_green: bool = frame.state.button_palette == ButtonPalette.Semantic
    true_color: u32 = 0x00aa00 if true_green else 0xaa0000
    false_color: u32 = 0xaa0000 if true_green else 0x00aa00
    raster_rect(true_x, 340, 100, 38, true_color)
    raster_rect(false_x, 340, 100, 38, false_color)
    raster_text(true_x + 20, 350, 2, "TRUE", 0xffffff)
    raster_text(false_x + 14, 350, 2, "FALSE", 0xffffff)

def raster_timer(remaining_permille: i32 where remaining_permille >= 0 and remaining_permille <= 1000) -> void:
    raster_rect(20, 18, 600, 10, 0x26313a)
    width: i32 = 600 * remaining_permille / 1000
    raster_rect(20, 18, width, 10, 0x3cc86e)

def raster_boolean_node(index: i32, total: i32,
                        content: PublicExpressionSummary,
                        lexicon: EntityLexicon&,
                        frame: PresentationFrame&, color: u32) -> void:
    raster_text(22, 48, 2, "BOOLEAN EXPRESSION", color)
    raster_text(22, 82, 1, "NODE", color)
    raster_number(64, 82, 1, index, color)
    raster_text(106, 82, 1, "/", color)
    raster_number(124, 82, 1, total, color)
    match content:
        PublicExpressionSummary.RelationalLeaf(conclusion):
            raster_text(22, 112, 2, "RELATION LEAF", color)
            raster_premise(conclusion, lexicon, frame)
        PublicExpressionSummary.CategoricalLeaf(conclusion):
            raster_text(22, 112, 2, "SYLLOGISM LEAF", color)
            raster_premise(conclusion, lexicon, frame)
        PublicExpressionSummary.Apply(op, left, right):
            raster_text(150, 150, 4, binary_operator_name(op), 0xf0c850)
            raster_text(150, 230, 2, "LEFT NODE", color)
            raster_number(330, 230, 2, left, color)
            raster_text(150, 270, 2, "RIGHT NODE", color)
            raster_number(342, 270, 2, right, color)

def raster_render_card(card: RenderCard, lexicon: EntityLexicon&,
                       frame: PresentationFrame&,
                       remaining_permille: i32 where remaining_permille >= 0 and remaining_permille <= 1000) -> void:
    raster_fill(0x0a0e12)
    raster_rect(8, 8, 624, 384, 0x5ab4d2)
    raster_rect(12, 12, 616, 376, 0x0a0e12)
    raster_timer(remaining_permille)
    body: u32 = 0xff3030 if frame.body_ink == InkColor.Red else 0xf0f4f5
    match card:
        RenderCard.NegationExplainer:
            raster_text(22, 48, 2, "NEGATION RULE", 0xf0c850)
            raster_text(92, 168, 3, "INVERT THE", body)
            raster_text(330, 168, 3, "RED", 0xff3030)
            raster_text(424, 168, 3, "TEXT", body)
        RenderCard.Premise(index, total, content):
            raster_text(22, 48, 2, "PREMISE", body)
            raster_number(130, 48, 2, index + 1, body)
            raster_text(170, 48, 2, "/", body)
            raster_number(190, 48, 2, total, body)
            raster_premise(content, lexicon, frame)
        RenderCard.Conclusion(content):
            raster_text(22, 48, 2, "CONCLUSION", 0xf0c850)
            raster_premise(content, lexicon, frame)
            raster_buttons(frame)
        RenderCard.BooleanPremise(atom, index, total, content):
            raster_text(22, 48, 2, "BOOLEAN PREMISE", body)
            raster_text(290, 48, 1, "ATOM", body)
            raster_number(330, 48, 1, atom, body)
            raster_premise(content, lexicon, frame)
        RenderCard.BooleanNode(index, total, content):
            raster_boolean_node(index, total, content, lexicon, frame, body)
        RenderCard.BooleanConclusion:
            raster_text(22, 72, 3, "BOOLEAN ANSWER", 0xf0c850)
            raster_buttons(frame)
        RenderCard.AnalogyConclusion(first_left, first_right,
                                     second_left, second_right, claimed_same):
            raster_text(22, 48, 2, "ANALOGY", 0xf0c850)
            assert first_left >= 0 and first_left < lexicon.entity_count
            assert first_right >= 0 and first_right < lexicon.entity_count
            assert second_left >= 0 and second_left < lexicon.entity_count
            assert second_right >= 0 and second_right < lexicon.entity_count
            a: i32 where a >= 0 and a < lexicon.entity_count = first_left
            b: i32 where b >= 0 and b < lexicon.entity_count = first_right
            c: i32 where c >= 0 and c < lexicon.entity_count = second_left
            d: i32 where d >= 0 and d < lexicon.entity_count = second_right
            raster_entity(18, 96, lexicon, a, body)
            raster_entity(434, 96, lexicon, b, body)
            raster_text(220, 108, 1, "TO", body)
            raster_text(218, 180, 1,
                        "SAME RELATION" if claimed_same == Truth.True else "DIFFERENT RELATION",
                        0xf0c850)
            raster_entity(18, 240, lexicon, c, body)
            raster_entity(434, 240, lexicon, d, body)
            raster_text(220, 252, 1, "TO", body)
            raster_buttons(frame)
        RenderCard.SortingCard(index, total, content):
            raster_text(22, 48, 2, "SORT CARD", body)
            raster_number(170, 48, 2, index + 1, body)
            raster_text(210, 48, 2, "/", body)
            raster_number(230, 48, 2, total, body)
            raster_sort_card(content, body)
        RenderCard.Challenge(content):
            raster_text(22, 48, 2, "DETERMINISTIC CHALLENGE", 0xf0c850)
            raster_text(22, 94, 1, "VALUES", body)
            for i in 0..<content.value_count:
                raster_number(22 + i * 38, 132, 1, content.values[i.usize()], body)
            raster_buttons(frame)
        RenderCard.FixedPremise(family, puzzle_id, line):
            assert puzzle_id >= 0 and puzzle_id < 12
            assert line >= 0
            raster_text(22, 48, 2, "PUZZLE PREMISE", body)
            raster_number(230, 50, 1, line + 1, body)
            raster_text_wrapped(22, 132, 1,
                                fixed_premise_text(family, puzzle_id, line),
                                96, body)
        RenderCard.FixedConclusion(family, puzzle_id):
            assert puzzle_id >= 0 and puzzle_id < 12
            raster_text(22, 48, 2, "PUZZLE CONCLUSION", 0xf0c850)
            raster_text_wrapped(22, 132, 1,
                                fixed_conclusion_text(family, puzzle_id),
                                96, body)
            raster_buttons(frame)
        RenderCard.Feedback(outcome, elapsed_ms, score, round):
            feedback_color: u32 = match outcome:
                Outcome.Correct: 0x3cc86e
                Outcome.Wrong: 0xff3030
                Outcome.Timeout: 0xf0c850
            feedback_text: cstr = match outcome:
                Outcome.Correct: "CORRECT"
                Outcome.Wrong: "WRONG"
                Outcome.Timeout: "TIMEOUT"
            raster_text(176, 86, 4, feedback_text, feedback_color)
            raster_text(130, 190, 2, "RESPONSE MS", body)
            raster_number(342, 190, 2, elapsed_ms, body)
            raster_text(130, 238, 2, "SCORE", body)
            raster_number(250, 238, 2, score, body)
            raster_text(350, 238, 2, "ROUND", body)
            raster_number(470, 238, 2, round, body)
