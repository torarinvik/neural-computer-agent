# Pull-based public card stream consumed by raster and audio renderers.

include "syllogimous_public_view.elisa"

enum PublicExpressionSummary:
    RelationalLeaf(conclusion: PublicPremise)
    CategoricalLeaf(conclusion: PublicPremise)
    Apply(op: BinaryOperator,
          left: i32 where left >= 0 and left < 511,
          right: i32 where right >= 0 and right < 511)

enum RenderCard:
    NegationExplainer
    Premise(index: i32 where index >= 0, total: i32 where total >= 1,
            content: PublicPremise)
    Conclusion(content: PublicPremise)
    BooleanPremise(atom: i32 where atom >= 0 and atom < 511,
                   index: i32 where index >= 0,
                   total: i32 where total >= 1,
                   content: PublicPremise)
    BooleanNode(index: i32 where index >= 0 and index < 511,
                total: i32 where total >= 1 and total <= 511,
                content: PublicExpressionSummary)
    BooleanConclusion
    AnalogyConclusion(first_left: i32 where first_left >= 0 and first_left < 256,
                      first_right: i32 where first_right >= 0 and first_right < 256,
                      second_left: i32 where second_left >= 0 and second_left < 256,
                      second_right: i32 where second_right >= 0 and second_right < 256,
                      claimed_same: Truth)
    SortingCard(index: i32 where index >= 0 and index < 34,
                total: i32 where total >= 4 and total <= 34,
                content: PublicSortCard)
    Challenge(content: PublicChallenge)
    FixedPremise(family: QuestionFamily,
                 puzzle_id: i32 where puzzle_id >= 0 and puzzle_id < 12,
                 line: i32 where line >= 0)
    FixedConclusion(family: QuestionFamily,
                    puzzle_id: i32 where puzzle_id >= 0 and puzzle_id < 12)
    Feedback(outcome: Outcome,
             elapsed_ms: i32 where elapsed_ms >= 0 and elapsed_ms <= 300000,
             score: i32 where score >= -9999 and score <= 9999,
             round: i32 where round >= 1 and round <= 9999)

struct RenderCursor:
    major: mutable i32
    minor: mutable i32
    conclusion_emitted: mutable bool
    boolean_expression: mutable bool

def initial_render_cursor() -> RenderCursor:
    return RenderCursor{
        major: 0,
        minor: 0,
        conclusion_emitted: false,
        boolean_expression: false
    }

def fixed_premise_count(family: QuestionFamily,
                        puzzle_id: i32 where puzzle_id >= 0 and puzzle_id < 12) -> i32 where result >= 1 and result <= 8:
    count: i32 = match family:
        QuestionFamily.Paradox:
            when puzzle_id:
                0 -> 2
                1 -> 2
                2 -> 2
                3 -> 2
                4 -> 1
                5 -> 2
                6 -> 1
                7 -> 1
                8 -> 2
                9 -> 2
                10 -> 1
                11 -> 1
                _ -> 1
        QuestionFamily.LogicPuzzle:
            when puzzle_id:
                0 -> 8
                1 -> 4
                2 -> 7
                3 -> 5
                4 -> 3
                5 -> 5
                6 -> 8
                7 -> 5
                8 -> 4
                9 -> 5
                10 -> 7
                11 -> 6
                _ -> 1
        _:
            1
    assert count >= 1 and count <= 8
    return count

def next_relational_card(cursor: lmut RenderCursor,
                         content: PublicRelationalQuestion&) -> RenderCard?:
    if cursor.major < content.premise_count:
        index: i32 = cursor.major
        cursor.major <- cursor.major + 1
        assert index >= 0
        assert content.premise_count >= 1
        return RenderCard.Premise(index, content.premise_count,
                                  content.premises[index.usize()])
    if not cursor.conclusion_emitted:
        cursor.conclusion_emitted <- true
        return RenderCard.Conclusion(content.conclusion)
    return null

def next_categorical_card(cursor: lmut RenderCursor,
                          content: PublicCategoricalQuestion&) -> RenderCard?:
    if cursor.major < content.premise_count:
        index: i32 = cursor.major
        cursor.major <- cursor.major + 1
        assert index >= 0
        assert content.premise_count >= 1
        return RenderCard.Premise(index, content.premise_count,
                                  content.premises[index.usize()])
    if not cursor.conclusion_emitted:
        cursor.conclusion_emitted <- true
        return RenderCard.Conclusion(content.conclusion)
    return null

def next_boolean_card(cursor: lmut RenderCursor,
                      content: PublicBooleanQuestion&) -> RenderCard?:
    if not cursor.boolean_expression:
        for scan in 0..<content.node_count:
            if cursor.major < content.node_count:
                node_index: i32 = cursor.major
                assert node_index >= 0 and node_index < 511
                match content.nodes[node_index.usize()]:
                    PublicExpressionNode.Leaf(base):
                        match content.bases[base.usize()]:
                            PublicBaseQuestion.Relational(atom):
                                if cursor.minor < atom.premise_count:
                                    premise_index: i32 = cursor.minor
                                    cursor.minor <- cursor.minor + 1
                                    assert premise_index >= 0
                                    assert atom.premise_count >= 1
                                    return RenderCard.BooleanPremise(
                                        node_index, premise_index, atom.premise_count,
                                        atom.premises[premise_index.usize()]
                                    )
                            PublicBaseQuestion.Categorical(atom):
                                if cursor.minor < atom.premise_count:
                                    premise_index: i32 = cursor.minor
                                    cursor.minor <- cursor.minor + 1
                                    assert premise_index >= 0
                                    assert atom.premise_count >= 1
                                    return RenderCard.BooleanPremise(
                                        node_index, premise_index, atom.premise_count,
                                        atom.premises[premise_index.usize()]
                                    )
                        cursor.major <- cursor.major + 1
                        cursor.minor <- 0
                    PublicExpressionNode.Apply(op, left, right):
                        cursor.major <- cursor.major + 1
                        cursor.minor <- 0
        cursor.boolean_expression <- true
        cursor.major <- 0
    if cursor.major < content.node_count:
        node_index: i32 = cursor.major
        cursor.major <- cursor.major + 1
        assert node_index >= 0 and node_index < 511
        assert content.node_count >= 1 and content.node_count <= 511
        summary: mutable PublicExpressionSummary = zeroed
        match content.nodes[node_index.usize()]:
            PublicExpressionNode.Leaf(base):
                match content.bases[base.usize()]:
                    PublicBaseQuestion.Relational(atom):
                        summary <- PublicExpressionSummary.RelationalLeaf(atom.conclusion)
                    PublicBaseQuestion.Categorical(atom):
                        summary <- PublicExpressionSummary.CategoricalLeaf(atom.conclusion)
            PublicExpressionNode.Apply(op, left, right):
                summary <- PublicExpressionSummary.Apply(op, left, right)
        return RenderCard.BooleanNode(
            node_index, content.node_count, summary
        )
    if not cursor.conclusion_emitted:
        cursor.conclusion_emitted <- true
        return RenderCard.BooleanConclusion
    return null

def next_analogy_card(cursor: lmut RenderCursor,
                      content: PublicAnalogyQuestion&) -> RenderCard?:
    if cursor.major < content.premise_count:
        index: i32 = cursor.major
        cursor.major <- cursor.major + 1
        assert index >= 0
        assert content.premise_count >= 1
        return RenderCard.Premise(index, content.premise_count,
                                  content.premises[index.usize()])
    if not cursor.conclusion_emitted:
        cursor.conclusion_emitted <- true
        return RenderCard.AnalogyConclusion(
            content.first_left, content.first_right,
            content.second_left, content.second_right,
            content.claimed_same
        )
    return null

def next_sorting_card(cursor: lmut RenderCursor,
                      content: PublicSortingQuestion&) -> RenderCard?:
    if cursor.major < content.card_count:
        index: i32 = cursor.major
        cursor.major <- cursor.major + 1
        assert index >= 0 and index < 34
        assert content.card_count >= 4 and content.card_count <= 34
        return RenderCard.SortingCard(index, content.card_count,
                                     content.cards[index.usize()])
    return null

def next_fixed_card(cursor: lmut RenderCursor,
                    content: PublicFixedPuzzle&) -> RenderCard?:
    assert content.puzzle_id >= 0 and content.puzzle_id < 12
    puzzle_id: i32 where puzzle_id >= 0 and puzzle_id < 12 = content.puzzle_id
    count_raw: i32 = fixed_premise_count(content.family, puzzle_id)
    assert count_raw >= 1 and count_raw <= 8
    count: i32 where count >= 1 and count <= 8 = count_raw
    if cursor.major < count:
        line: i32 = cursor.major
        cursor.major <- cursor.major + 1
        assert line >= 0
        return RenderCard.FixedPremise(content.family, puzzle_id, line)
    if not cursor.conclusion_emitted:
        cursor.conclusion_emitted <- true
        return RenderCard.FixedConclusion(content.family, puzzle_id)
    return null

def next_challenge_card(cursor: lmut RenderCursor,
                        content: PublicChallenge) -> RenderCard?:
    if not cursor.conclusion_emitted:
        cursor.conclusion_emitted <- true
        return RenderCard.Challenge(content)
    return null

# Unified pull boundary used by every sensory renderer. No renderer needs to
# match the private `Question` type or can accidentally observe its answer.
def next_render_card(cursor: lmut RenderCursor,
                     question: PublicQuestion) -> RenderCard?:
    match question:
        PublicQuestion.Relational(family, content):
            rebind result: RenderCard?, cursor = next_relational_card(cursor, content)
            return result
        PublicQuestion.Categorical(content):
            rebind result: RenderCard?, cursor = next_categorical_card(cursor, content)
            return result
        PublicQuestion.Boolean(family, content):
            rebind result: RenderCard?, cursor = next_boolean_card(cursor, content)
            return result
        PublicQuestion.Analogy(content):
            rebind result: RenderCard?, cursor = next_analogy_card(cursor, content)
            return result
        PublicQuestion.Sorting(content):
            rebind result: RenderCard?, cursor = next_sorting_card(cursor, content)
            return result
        PublicQuestion.Challenge(content):
            rebind result: RenderCard?, cursor = next_challenge_card(cursor, content)
            return result
        PublicQuestion.Fixed(content):
            rebind result: RenderCard?, cursor = next_fixed_card(cursor, content)
            return result

def feedback_render_card(record: RoundRecord&, ledger: GameLedger&) -> RenderCard:
    elapsed_raw: i64 = record.elapsed_ms
    elapsed_clamped: i64 = 300000 if elapsed_raw > 300000 else elapsed_raw
    assert elapsed_clamped >= 0 and elapsed_clamped <= 300000
    elapsed_ms: i32 where elapsed_ms >= 0 and elapsed_ms <= 300000 = elapsed_clamped.i32()
    score_visible: i64 = -9999 if ledger.score < -9999 else (
        9999 if ledger.score > 9999 else ledger.score
    )
    assert score_visible >= -9999 and score_visible <= 9999
    score_raw: i32 = score_visible.i32()
    assert score_raw >= -9999 and score_raw <= 9999
    score: i32 where score >= -9999 and score <= 9999 = score_raw
    round_visible: i64 = 9999 if ledger.rounds > 9999 else ledger.rounds
    assert round_visible >= 1 and round_visible <= 9999
    round_raw: i32 = round_visible.i32()
    assert round_raw >= 1 and round_raw <= 9999
    round: i32 where round >= 1 and round <= 9999 = round_raw
    return RenderCard.Feedback(record.outcome, elapsed_ms, score, round)
