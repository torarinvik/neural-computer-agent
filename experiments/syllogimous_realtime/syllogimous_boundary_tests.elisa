# Black-box boundary regression: rendering is a function of the public card
# only.  Private ChallengeData.answer is intentionally absent from this file.
include "syllogimous_sensory.elisa"

def checksum_screen() -> u64:
    total: mutable u64 = 0
    for i in 0..<(RASTER_W * RASTER_H * 3):
        total <- (total * 131) + Encoder::SCREEN_GRAB[i.usize()].u64()
    return total

def checksum_audio(packet: SensoryPacket) -> u64:
    total: mutable u64 = 0
    for i in 0..<packet.pcm_count:
        total <- (total * 131) + packet.pcm[i.usize()].i64().u64()
    return total

def check_boundary() -> int error[GenerationError]:
    values: mutable array[i32, 16] = zeroed
    values[0] <- 4
    values[1] <- 7
    values[2] <- 9
    public: PublicChallenge = PublicChallenge{
        kind: ChallengeKind.ArithmeticChain,
        values: values,
        value_count: 3,
        claim: 20
    }
    card: RenderCard = RenderCard.Challenge(public)
    rng: mutable Rng = rng_from_seed(4444)
    rebind lexicon: EntityLexicon, rng = generate_entity_lexicon(rng, Vocabulary.Abstract, 32)
    state: mutable PresentationState = initial_presentation_state()
    options: PresentationOptions = PresentationOptions{
        negation_enabled: false,
        negation_explainer_enabled: false,
        stroop_enabled: false
    }
    rebind presentation: PresentationFrame, rng, state = advance_presentation(
        rng, state, options, false
    )
    first: SensoryPacket = render_sensory_packet(card, lexicon, presentation, 900, 1234)
    first_screen: u64 = checksum_screen()
    second: SensoryPacket = render_sensory_packet(card, lexicon, presentation, 900, 1234)
    second_screen: u64 = checksum_screen()
    if checksum_audio(first) != checksum_audio(second) or first_screen != second_screen:
        return 1
    if first.width != 640 or first.height != 400 or first.pcm_count <= 0:
        return 2
    return 0

def main() -> int:
    return catch check_boundary():
        code: code
        error failure: 90
