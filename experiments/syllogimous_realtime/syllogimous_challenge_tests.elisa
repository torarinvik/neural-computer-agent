include "syllogimous_challenges.elisa"

def data_for(kind: ChallengeKind, a: i32, b: i32, c: i32) -> ChallengeData:
    values: mutable array[i32, 16] = zeroed
    values[0] <- a
    values[1] <- b
    values[2] <- c
    return ChallengeData{kind: kind, values: values, value_count: 3, claim: 0, answer: 0}

def check_challenges() -> int error[GenerationError]:
    arithmetic: ChallengeData = data_for(ChallengeKind.ArithmeticChain, 4, 7, 9)
    if not try verify_challenge(arithmetic, 20): return 1
    inequality: ChallengeData = data_for(ChallengeKind.InequalityChain, 1, 3, 8)
    if not try verify_challenge(inequality, 1): return 2
    parity: ChallengeData = data_for(ChallengeKind.Parity, 11, 0, 0)
    if not try verify_challenge(parity, 1): return 3
    sequence: ChallengeData = data_for(ChallengeKind.Sequence, 2, 4, 6)
    if not try verify_challenge(sequence, 8): return 4
    reachability: ChallengeData = data_for(ChallengeKind.GraphReachability, 1, 3, 3)
    if not try verify_challenge(reachability, 1): return 5
    distance: ChallengeData = data_for(ChallengeKind.GraphDistance, 0, 3, 2)
    if not try verify_challenge(distance, 1): return 6
    temporal: ChallengeData = data_for(ChallengeKind.TemporalOrder, 1, 2, 3)
    if not try verify_challenge(temporal, 1): return 7
    membership: ChallengeData = data_for(ChallengeKind.Membership, 5, 2, 5)
    if not try verify_challenge(membership, 1): return 8
    formula: ChallengeData = data_for(ChallengeKind.BooleanFormula, 1, 0, 0)
    if not try verify_challenge(formula, 1): return 9
    assignment: ChallengeData = data_for(ChallengeKind.ConstraintAssignment, -7, 0, 0)
    if not try verify_challenge(assignment, 7): return 10
    minimum: ChallengeData = data_for(ChallengeKind.MinimumValue, 9, 4, 7)
    if not try verify_challenge(minimum, 4): return 11
    maximum: ChallengeData = data_for(ChallengeKind.MaximumValue, 9, 4, 7)
    if not try verify_challenge(maximum, 9): return 12
    absolute: ChallengeData = data_for(ChallengeKind.AbsoluteDifference, 9, 4, 0)
    if not try verify_challenge(absolute, 5): return 13
    intersection: ChallengeData = data_for(ChallengeKind.SetIntersection, 5, 2, 5)
    if not try verify_challenge(intersection, 1): return 14
    cycle: ChallengeData = data_for(ChallengeKind.GraphCycle, 1, 2, 1)
    if not try verify_challenge(cycle, 1): return 15
    topological: ChallengeData = data_for(ChallengeKind.TopologicalOrder, 1, 2, 3)
    if not try verify_challenge(topological, 1): return 16
    calendar: ChallengeData = data_for(ChallengeKind.CalendarOffset, 5, 4, 0)
    if not try verify_challenge(calendar, 2): return 17
    xor_formula: ChallengeData = data_for(ChallengeKind.XorFormula, 1, 0, 0)
    if not try verify_challenge(xor_formula, 1): return 18
    equation: ChallengeData = data_for(ChallengeKind.LinearEquation, 3, 2, 11)
    if not try verify_challenge(equation, 3): return 19
    digits: ChallengeData = data_for(ChallengeKind.DigitCount, 1234, 0, 0)
    if not try verify_challenge(digits, 4): return 20
    sweep_rng: mutable Rng = rng_from_seed(123456)
    for i in 0..<4096:
        rebind generated: ChallengeData error[GenerationError], sweep_rng = generate_challenge(sweep_rng)
        challenge: ChallengeData = try generated
        solution: ChallengeSolution = try unique_challenge_solution(challenge)
        if solution.candidate_count != 1 or solution.answer != challenge.answer:
            return 21
        if not try verify_challenge(challenge, challenge.answer):
            return 22
    return 0

def main() -> int:
    return catch check_challenges():
        code: code
        error failure: 99
