include "syllogimous_runtime.elisa"
include "syllogimous_host_config.elisa"

def check_hard_config() -> int error[GenerationError, DriverError, RuntimeError]:
    started_ms: i64 where started_ms >= 0 = 1000
    result: GameRuntime error[GenerationError] = start_game_runtime(
        7, hard_host_selection(), started_ms
    )
    runtime: GameRuntime = try result
    packet: SensoryPacket = try observe_game_runtime(runtime, started_ms)
    if packet.timestamp_ms != started_ms or packet.pcm_count <= 0:
        return 92
    return 0

def main() -> int:
    return catch check_hard_config():
        code: code
        error failure: 90
