def emit_sorting(question: PublicSortingQuestion&, lexicon: EntityLexicon&,
                 presentation: PresentationFrame&,
                 frame_index: lmut i32) -> void:
    cursor: mutable RenderCursor = initial_render_cursor()
    for scan in 0..<64:
        rebind card: RenderCard?, cursor = next_sorting_card(cursor, question)
        if card is visible:
            frame_index <- write_visible_card(visible, lexicon, presentation, frame_index)

def emit_fixed(question: PublicFixedPuzzle&, lexicon: EntityLexicon&,
               presentation: PresentationFrame&,
               frame_index: lmut i32) -> void:
    cursor: mutable RenderCursor = initial_render_cursor()
    for scan in 0..<64:
        rebind card: RenderCard?, cursor = next_fixed_card(cursor, question)
        if card is visible:
            frame_index <- write_visible_card(visible, lexicon, presentation, frame_index)

def emit_public(question: PublicQuestion, lexicon: EntityLexicon&,
                presentation: PresentationFrame&,
                frame_index: lmut i32) -> void:
    cursor: mutable RenderCursor = initial_render_cursor()
    for scan in 0..<2048:
        rebind card: RenderCard?, cursor = next_render_card(cursor, question)
        if card is visible:
            frame_index <- write_visible_card(
                visible, lexicon, presentation, frame_index
            )

def render_smoke_suite() -> int error[GenerationError]:
    trusted Unsafe.PointerCast:
        _ = mkdir(SMOKE_DIR.cast[u8&], 493)
    rng: mutable Rng = rng_from_seed(20260718)
    rebind lexicon: EntityLexicon, rng = generate_entity_lexicon(
        rng, Vocabulary.Meaningful, 256
    )
    state: mutable PresentationState = initial_presentation_state()
    options: PresentationOptions = PresentationOptions{
        negation_enabled: true,
        negation_explainer_enabled: true,
        stroop_enabled: true
    }
    rebind presentation: PresentationFrame, rng, state = advance_presentation(
        rng, state, options, true
    )
    frame_index: mutable i32 = 0

    rebind relational: RelationalQuestion, rng = generate_distinction(rng, 4)
    rebind negated: RelationalQuestion, rng = add_relational_negation(rng, relational)
    rebind meta_result: RelationalQuestion error[GenerationError], rng = add_meta_relations(rng, negated)
    meta: RelationalQuestion = try meta_result
    assert meta.conclusion.left >= 0 and meta.conclusion.left < 256
    assert meta.conclusion.right >= 0 and meta.conclusion.right < 256
    public_meta: PublicRelationalQuestion = public_relational(meta)
    assert public_meta.conclusion.left >= 0 and public_meta.conclusion.left < 256
    assert public_meta.conclusion.right >= 0 and public_meta.conclusion.right < 256
    conclusion_probe: RenderCard? = RenderCard.Conclusion(public_meta.conclusion)
    if conclusion_probe is visible_probe:
        match visible_probe:
            RenderCard.Conclusion(probe_content):
                assert probe_content.left >= 0 and probe_content.left < 256
                assert probe_content.right >= 0 and probe_content.right < 256
            _:
                assert false
    frame_index <- emit_public(
        public_question(Question.Relational(QuestionFamily.Distinction, meta)),
        lexicon, presentation, frame_index
    )

    rebind categorical_result: CategoricalQuestion error[GenerationError], rng = generate_categorical(rng, 4)
    categorical: CategoricalQuestion = try categorical_result
    public_categorical_question: PublicCategoricalQuestion = public_categorical(categorical)
    frame_index <- emit_public(
        public_question(Question.Categorical(categorical)),
        lexicon, presentation, frame_index
    )

    rebind boolean_result: BooleanQuestion error[GenerationError], rng = generate_boolean(
        rng, 2, 2, all_binary_operators()
    )
    boolean: BooleanQuestion = try boolean_result
    public_boolean_question: PublicBooleanQuestion = public_boolean(boolean)
    frame_index <- emit_public(
        public_question(Question.Boolean(QuestionFamily.NestedBinary, boolean)),
        lexicon, presentation, frame_index
    )

    rebind analogy_result: AnalogyQuestion error[GenerationError], rng = generate_analogy(rng, 5)
    analogy: AnalogyQuestion = try analogy_result
    public_analogy_question: PublicAnalogyQuestion = public_analogy(analogy)
    frame_index <- emit_public(
        public_question(Question.Analogy(analogy)),
        lexicon, presentation, frame_index
    )

    rebind sorting_result: SortingQuestion error[GenerationError], rng = generate_sorting(rng, 7, 2)
    sorting: SortingQuestion = try sorting_result
    public_sorting_question: PublicSortingQuestion = public_sorting(sorting)
    frame_index <- emit_public(
        public_question(Question.Sorting(sorting)),
        lexicon, presentation, frame_index
    )

    fixed: FixedPuzzle = FixedPuzzle{
        family: QuestionFamily.Paradox,
        puzzle_id: 0,
        answer: FixedPuzzleAnswer.Undetermined
    }
    public_fixed_question: PublicFixedPuzzle = public_fixed(fixed)
    frame_index <- emit_public(
        public_question(Question.Fixed(fixed)),
        lexicon, presentation, frame_index
    )
    feedback: RenderCard = RenderCard.Feedback(
        Outcome.Correct, 1234, 1, 1
    )
    frame_index <- write_visible_card(
        feedback, lexicon, presentation, frame_index
    )
    return 0 if frame_index > 0 else 1

def main() -> int:
    catch render_smoke_suite():
        code:
            return code
        error failure:
            return 2
