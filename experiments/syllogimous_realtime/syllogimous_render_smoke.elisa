include "syllogimous_raster.elisa"

global SMOKE_DIR: cstr = "/tmp/syllogimous_raster_smoke"

def write_visible_card(card: RenderCard, lexicon: EntityLexicon&,
                       presentation: PresentationFrame&,
                       frame_index: lmut i32) -> void:
    assert lexicon.entity_count == 256
    raster_render_card(card, lexicon, presentation, 1000)
    trusted Unsafe.PointerCast:
        Encoder::write_frame_ppm(SMOKE_DIR, frame_index.i64(), RASTER_W, RASTER_H)
    frame_index <- frame_index + 1

def emit_relational(question: PublicRelationalQuestion&, lexicon: EntityLexicon&,
                    presentation: PresentationFrame&,
                    frame_index: lmut i32) -> void:
    cursor: mutable RenderCursor = initial_render_cursor()
    for scan in 0..<64:
        rebind card: RenderCard?, cursor = next_relational_card(cursor, question)
        if card is visible:
            frame_index <- write_visible_card(visible, lexicon, presentation, frame_index)

def emit_categorical(question: PublicCategoricalQuestion&, lexicon: EntityLexicon&,
                     presentation: PresentationFrame&,
                     frame_index: lmut i32) -> void:
    cursor: mutable RenderCursor = initial_render_cursor()
    for scan in 0..<64:
        rebind card: RenderCard?, cursor = next_categorical_card(cursor, question)
        if card is visible:
            frame_index <- write_visible_card(visible, lexicon, presentation, frame_index)

def emit_boolean(question: PublicBooleanQuestion&, lexicon: EntityLexicon&,
                 presentation: PresentationFrame&,
                 frame_index: lmut i32) -> void:
    cursor: mutable RenderCursor = initial_render_cursor()
    for scan in 0..<128:
        rebind card: RenderCard?, cursor = next_boolean_card(cursor, question)
        if card is visible:
            frame_index <- write_visible_card(visible, lexicon, presentation, frame_index)

