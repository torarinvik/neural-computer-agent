# Disposable training products. Curated milestones are force-added explicitly
# under artifacts/checkpoints or artifacts/candidates.
*.pt
*.pth
*.bin
*.idx
!artifacts/candidates/core263_parent.pt

# Local runtime products.
*.log
*.ppm
videos/
runs/
wandb/
/experiments/unified_cognitive_controller/reports/

# Session-local experiment sweeps. Selected evidence reports may be
# force-added alongside promoted milestones.
/session_records/*/raw/
# Nested session sweeps (session_records/<run>/<arm>/raw/). Selected evidence
# reports are force-added alongside promoted milestones.
/session_records/*/*/raw/
